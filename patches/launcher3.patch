diff --git a/quickstep/src/com/android/launcher3/uioverrides/ZetaWorkspaceHomes.java b/quickstep/src/com/android/launcher3/uioverrides/ZetaWorkspaceHomes.java
new file mode 100644
index 0000000000000000000000000000000000000000..4324487e8135a128194bdb10745d6d2a87ec4531
--- /dev/null
+++ b/quickstep/src/com/android/launcher3/uioverrides/ZetaWorkspaceHomes.java
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3.uioverrides;
+
+import com.android.launcher3.Launcher;
+import com.android.launcher3.util.ContextTracker;
+
+/** Per-panel lifecycle registry; the launcher application and icon model remain shared. */
+public final class ZetaWorkspaceHomes {
+    public static final String PANEL_EXTRA = "org.lineageos.zeta.workspace.PANEL";
+    private static int sFocusedPanel = 0;
+    private static long sGestureDownTime = -1;
+    private static boolean sGestureInRegion;
+    private static boolean sGestureOtherPaneShade;
+    private static android.app.TaskInfo sGestureTask;
+    private static com.android.launcher3.ZetaTossGesture sToss;
+    private static android.widget.PopupWindow sTossHint;
+    private static long sTossGeneration;
+    private static int sTossSource, sTossTask = -1;
+
+    /** Observe only Quickstep's existing stream, before rotation transforms it. */
+    public static Runnable observeToss(android.view.MotionEvent event) {
+        int action = event.getActionMasked();
+        if (action == android.view.MotionEvent.ACTION_DOWN) {
+            clearToss();
+            android.os.Bundle state = snapshot();
+            if (!sGestureInRegion || sGestureTask == null || state.getInt("composition") != 2
+                    || state.getBoolean("locked") || state.getBoolean("lock_task") || state.getBoolean("switching")
+                    || state.getInt("spanned_task", -1) >= 0
+                    || sGestureTask.getActivityType() != android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD) return null;
+            sTossSource = sFocusedPanel; sTossTask = sGestureTask.taskId;
+            android.graphics.Rect from = state.getParcelable("bounds_" + sTossSource, android.graphics.Rect.class);
+            android.graphics.Rect to = state.getParcelable("bounds_" + (1-sTossSource), android.graphics.Rect.class);
+            if (from == null || to == null) return null;
+            sToss = new com.android.launcher3.ZetaTossGesture(event.getRawX(), event.getRawY(),
+                    event.getEventTime(), android.app.ActivityThread.currentApplication().getResources().getDisplayMetrics().density,
+                    to.centerX()-from.centerX(), to.centerY()-from.centerY());
+        } else if (action == android.view.MotionEvent.ACTION_CANCEL || event.getPointerCount() != 1
+                || action == android.view.MotionEvent.ACTION_POINTER_DOWN) {
+            clearToss();
+        } else if (sToss != null) {
+            boolean ready = sToss.update(event.getRawX(), event.getRawY(), event.getEventTime());
+            if (ready && action == android.view.MotionEvent.ACTION_MOVE && sTossHint == null) {
+                Launcher home = tracker(sTossSource).getCreatedContext();
+                if (home != null && home.getDragLayer().isAttachedToWindow()
+                        && home.getDragLayer().getWidth() > 32*home.getResources().getDisplayMetrics().density) {
+                    float density = home.getResources().getDisplayMetrics().density;
+                    android.widget.TextView hint = new android.widget.TextView(home);
+                    hint.setText(sTossSource == 0 ? com.android.launcher3.R.string.zeta_toss_right
+                            : com.android.launcher3.R.string.zeta_toss_left);
+                    hint.setTextColor(android.graphics.Color.WHITE);
+                    hint.setTextSize(16);hint.setGravity(android.view.Gravity.CENTER);
+                    hint.setPadding((int)(16*density),(int)(10*density),(int)(16*density),(int)(10*density));
+                    hint.setBackgroundColor(0xee202020);
+                    sTossHint = new android.widget.PopupWindow(hint,
+                            Math.min(home.getDragLayer().getWidth()-(int)(32*density),(int)(320*density)),
+                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT,false);
+                    sTossHint.setTouchable(false);sTossHint.setClippingEnabled(true);
+                    try {
+                        sTossHint.showAtLocation(home.getDragLayer(), android.view.Gravity.TOP
+                                | android.view.Gravity.CENTER_HORIZONTAL,0,(int)(48*density));
+                    } catch (RuntimeException unavailable) {
+                        sTossHint=null; android.util.Log.d("ZetaToss","Preview owner is recreating");
+                    }
+                }
+            }
+            if (action == android.view.MotionEvent.ACTION_UP) {
+                final int source = sTossSource, task = sTossTask;
+                final long generation = sTossGeneration;
+                android.util.Log.i("ZetaToss", "release ready="+ready+" source="+source+" task="+task);
+                clearToss();
+                return ready ? () -> { if (generation == sTossGeneration) commitToss(source, task); } : null;
+            }
+        }
+        return null;
+    }
+    private static void clearToss() {
+        sToss = null; sTossTask = -1;
+        if (sTossHint != null) { sTossHint.dismiss(); sTossHint = null; }
+    }
+    private static void commitToss(int source, int task) {
+        android.os.Bundle state = snapshot();
+        android.app.ActivityManager.RunningTaskInfo current = state.getParcelable(
+                "standard_taskinfo_"+source, android.app.ActivityManager.RunningTaskInfo.class);
+        if (!state.getBoolean("enabled") || state.getBoolean("locked") || state.getBoolean("lock_task") || state.getBoolean("switching")
+                || state.getInt("composition") != 2 || state.getInt("spanned_task", -1) >= 0
+                || current == null || current.taskId != task) return;
+        try {
+            android.view.WindowManagerGlobal.getWindowManagerService().zetaWorkspaceAction(
+                    com.android.internal.zeta.ZetaWorkspaceProtocol.MOVE, 1-source, task);
+            // The emptied source can expose its BACKGROUND_APP full-screen snapshot.
+            // Only after both local scrolling and remote leashes finish, return that
+            // Home to NORMAL and drop its stale snapshot/targets, retaining task history.
+            Launcher home = tracker(source).getCreatedContext();
+            if (home != null && !home.isDestroyed()) {
+                com.android.quickstep.views.RecentsView recents = home.getOverviewPanel();
+                if (recents != null) recents.onRecentsAnimationComplete();
+                home.getStateManager().goToState(com.android.launcher3.LauncherState.NORMAL, false);
+                if (recents != null) recents.reset();
+            }
+            android.util.Log.i("ZetaToss", "Moved task="+task+" from="+source+" to="+(1-source));
+        } catch (android.os.RemoteException | RuntimeException error) {
+            android.util.Log.w("ZetaWorkspace", "Toss rejected after animation", error);
+        }
+    }
+
+
+    private ZetaWorkspaceHomes() { }
+
+    public static int panel(Launcher launcher) {
+        return launcher instanceof QuickstepLauncher
+                ? ((QuickstepLauncher) launcher).getZetaWorkspacePanel() : -1;
+    }
+
+    static int initialPanel(Launcher launcher) {
+        if (!com.android.launcher3.ZetaWorkspaceMode.enabled(launcher)) return -1;
+        int expected = launcher instanceof ZetaRightHome ? 1 : 0;
+        return launcher.getIntent().getIntExtra(PANEL_EXTRA, -1) == expected ? expected : -1;
+    }
+
+    public static ContextTracker.ActivityTracker<Launcher> tracker(int panel) {
+        return Launcher.getActivityTrackerForPanel(panel);
+    }
+
+    public static void focused(Launcher launcher) {
+        int panel = panel(launcher);
+        if (panel >= 0) sFocusedPanel = panel;
+    }
+
+    /** Shared Recents selects the same task into the invoking physical panel. */
+    public static boolean prepareRecentLaunch(com.android.quickstep.views.RecentsViewContainer container,
+            com.android.systemui.shared.recents.model.Task.TaskKey key,
+            android.app.ActivityOptions options) {
+        if (!(container instanceof Launcher)) return true;
+        int panel = ((Launcher) container).getWorkspacePanelId();
+        if (panel < 0) return true;
+        return prepareRecentLaunchOnPanel(key, options, panel, false);
+    }
+
+    private static boolean prepareRecentLaunchOnPanel(
+            com.android.systemui.shared.recents.model.Task.TaskKey key,
+            android.app.ActivityOptions options, int panel, boolean requireWorkspace) {
+        if (panel < 0 || panel > 1) return false;
+        try {
+            android.os.Bundle state = snapshot();
+            if (!state.getBoolean("enabled")) return !requireWorkspace;
+            if (state.getBoolean("locked") || state.getBoolean("lock_task") || state.getBoolean("switching")
+                    || (state.getInt("composition") != 2 && state.getInt("composition") != panel)) {
+                return false;
+            }
+            // TaskKey belongs to the asynchronously cached shared history. Its owner can
+            // predate the previous move. Resolve placement by task id on the server every time.
+            android.view.WindowManagerGlobal.getWindowManagerService().zetaWorkspaceAction(
+                    com.android.internal.zeta.ZetaWorkspaceProtocol.MOVE, panel, key.id);
+            if (options != null) options.setLaunchTaskDisplayAreaFeatureId(panel == 1
+                    ? android.window.DisplayAreaOrganizer.FEATURE_VENDOR_FIRST + 10
+                    : android.window.DisplayAreaOrganizer.FEATURE_DEFAULT_TASK_CONTAINER);
+            return true;
+        } catch (android.os.RemoteException | RuntimeException error) {
+            android.util.Log.w("ZetaWorkspace", "Recent task move rejected", error);
+            android.widget.Toast.makeText(android.app.ActivityThread.currentApplication(),
+                    com.android.launcher3.R.string.zeta_action_unavailable,
+                    android.widget.Toast.LENGTH_SHORT).show();
