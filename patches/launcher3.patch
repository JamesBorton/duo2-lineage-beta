+    public static int focusedPanel() { return sFocusedPanel; }
+    public static boolean active() {
+        return tracker(0).getCreatedContext() != null || tracker(1).getCreatedContext() != null;
+    }
+
+    private static android.os.Bundle snapshot() {
+        try {
+            android.os.Bundle state = android.view.WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            return state != null ? state : new android.os.Bundle();
+        } catch (android.os.RemoteException | SecurityException error) {
+            return new android.os.Bundle();
+        }
+    }
+
+    /** Capture physical coordinates before RotationTouchHelper transforms the event. */
+    public static void captureTouch(android.view.MotionEvent event) {
+        if (event.getDisplayId() != android.view.Display.DEFAULT_DISPLAY
+                || event.getActionMasked() != android.view.MotionEvent.ACTION_DOWN
+                || !com.android.launcher3.ZetaWorkspaceMode.enabled(android.app.ActivityThread.currentApplication())) return;
+        ++sTossGeneration;
+        sGestureDownTime = event.getDownTime();
+        sGestureInRegion = false;
+        sGestureOtherPaneShade = false;
+        sGestureTask = null;
+        android.os.Bundle state = snapshot();
+        if (!state.getBoolean("enabled", false) || state.getBoolean("switching", false)
+                || state.getBoolean("locked", false)
+                || state.getBoolean("lock_task", false)) {
+            sGestureDownTime = -1; // Preserve Android's normal lock-screen and unpin gesture regions.
+            return;
+        }
+        int composition = state.getInt("composition", 2);
+        int x = (int) event.getRawX(), y = (int) event.getRawY();
+        int panel = -1;
+        for (int candidate = 0; candidate < 2; candidate++) {
+            if (composition != 2 && composition != candidate) continue;
+            android.graphics.Rect bounds = state.getParcelable("bounds_" + candidate, android.graphics.Rect.class);
+            if (bounds != null && bounds.contains(x, y)) { panel = candidate; break; }
+        }
+        if (panel < 0) return;
+        sFocusedPanel = panel;
+        sGestureOtherPaneShade = state.getInt("shade_panel", -1) >= 0
+                && state.getInt("shade_panel", -1) != panel;
+        android.graphics.Rect bounds = state.getParcelable("bounds_" + panel, android.graphics.Rect.class);
+        int height = state.getInt("navigation_height", 0);
+        sGestureInRegion = bounds != null && height > 0 && y >= bounds.bottom - height;
+        if (sGestureInRegion) {
