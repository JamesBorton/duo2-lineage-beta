new file mode 100644
index 0000000000000000000000000000000000000000..532ee565dc25069829459ca4ffa55810cbae64a2
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/ZetaWorkspaceAnimationGeometry.java
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.quickstep.util;
+
+import android.graphics.Matrix;
+import android.graphics.Point;
+import android.util.SparseArray;
+import android.view.RemoteAnimationTarget;
+import android.window.TransitionInfo;
+import com.android.wm.shell.shared.TransitionUtil;
+
+/** Immutable display-to-animation-root origins for one Shell transition.
+ *
+ * Quickstep computes preview and Home matrices in display coordinates. Shell's
+ * animation leash may instead live beneath a pane-local transition root. Capture
+ * its actual origin, not a focused Home's origin or the task's parent position.
+ * Only points are retained: this object does not own any SurfaceControl handles.
+ */
+public final class ZetaWorkspaceAnimationGeometry {
+    public static final ZetaWorkspaceAnimationGeometry EMPTY =
+            new ZetaWorkspaceAnimationGeometry(new SparseArray<>());
+    private final SparseArray<Point> mRootOrigins;
+
+    private ZetaWorkspaceAnimationGeometry(SparseArray<Point> rootOrigins) {
+        mRootOrigins = rootOrigins;
+    }
+
+    public static ZetaWorkspaceAnimationGeometry capture(RemoteAnimationTarget[] targets,
+            TransitionInfo info) {
+        if (targets == null || info == null || info.getRootCount() == 0) return EMPTY;
+        SparseArray<Point> origins = new SparseArray<>();
+        for (RemoteAnimationTarget target : targets) {
+            if (target.taskInfo == null || target.taskInfo.zetaWorkspacePanel < 0) continue;
+            for (TransitionInfo.Change change : info.getChanges()) {
+                if (change.getTaskInfo() == null
+                        || change.getTaskInfo().taskId != target.taskId) continue;
+                // This is the same root lookup Shell uses when creating the remote leash.
+                origins.put(target.taskId, new Point(TransitionUtil.getRootFor(change, info)
+                        .getOffset()));
+                break;
+            }
+        }
+        return origins.size() == 0 ? EMPTY : new ZetaWorkspaceAnimationGeometry(origins);
+    }
+
+    /** Copies into scratch only when needed. The caller's display matrix stays unchanged. */
+    public Matrix toRootSpace(int taskId, Matrix displayMatrix, Matrix scratch) {
+        Point origin = mRootOrigins.get(taskId);
+        if (origin == null || (origin.x == 0 && origin.y == 0)) return displayMatrix;
+        scratch.set(displayMatrix);
+        // Display rotation/scale has already been composed. Translate in the final space.
+        scratch.postTranslate(-origin.x, -origin.y);
+        return scratch;
+    }
+
+    @Override public String toString() { return mRootOrigins.toString(); }
+}
