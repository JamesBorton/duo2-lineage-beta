+    public static Boolean capturedSwipeRegion(android.view.MotionEvent event) {
+        return event.getDisplayId() == android.view.Display.DEFAULT_DISPLAY
+                && event.getDownTime() == sGestureDownTime ? sGestureInRegion : null;
+    }
+
+    public static boolean hasCapturedWorkspaceSwipe() { return sGestureInRegion; }
+
+    public static long scopeSystemUiFlags(long flags) {
+        if (!sGestureInRegion) return flags;
+        flags &= ~com.android.systemui.shared.system.QuickStepContract.SYSUI_STATE_NAV_BAR_HIDDEN;
+        if (sGestureOtherPaneShade) flags &= ~(
+                com.android.systemui.shared.system.QuickStepContract.SYSUI_STATE_NOTIFICATION_PANEL_EXPANDED
+                | com.android.systemui.shared.system.QuickStepContract.SYSUI_STATE_QUICK_SETTINGS_EXPANDED);
+        return flags;
+    }
+
+    public static void finishTouch(long downTime) {
+        if (sGestureDownTime != downTime) return;
+        sGestureInRegion = false;
+        sGestureTask = null;
+    }
+
+    public static com.android.quickstep.TopTaskTracker.CachedTaskInfo gestureTask(
+            android.content.Context context, int displayId) {
+        return displayId == android.view.Display.DEFAULT_DISPLAY && sGestureTask != null
+                ? com.android.quickstep.TopTaskTracker.forWorkspaceTask(sGestureTask, context, displayId) : null;
+    }
+
+    public static void prepareRecents(com.android.quickstep.GestureState gesture, int displayId) {
+        if (displayId != android.view.Display.DEFAULT_DISPLAY
+                || !com.android.launcher3.ZetaWorkspaceMode.enabled(android.app.ActivityThread.currentApplication())) return;
+        if (snapshot().getBoolean("lock_task", false)) return;
+        int panel = gesture.getHomeIntent().getIntExtra(PANEL_EXTRA, sFocusedPanel);
+        try {
+            android.view.WindowManagerGlobal.getWindowManagerService().zetaWorkspaceAction(
+                    com.android.internal.zeta.ZetaWorkspaceProtocol.PREPARE_RECENTS, panel, -1);
+            android.os.Bundle state = snapshot();
+            sGestureTask = state.getParcelable("taskinfo_" + panel,
+                    android.app.ActivityManager.RunningTaskInfo.class);
+            if (sGestureTask != null) gesture.updateRunningTask(
+                    com.android.quickstep.TopTaskTracker.forWorkspaceTask(sGestureTask,
+                            android.app.ActivityThread.currentApplication(), displayId));
+        } catch (android.os.RemoteException | IllegalStateException | IllegalArgumentException error) {
+            android.util.Log.w("ZetaWorkspace", "Recents target is unavailable", error);
+        }
+    }
+
+    public static com.android.quickstep.BaseContainerInterface<?, ?> routeContainerInterface(
+            com.android.quickstep.BaseContainerInterface<?, ?> original,
+            android.content.Intent home, int displayId) {
+        if (displayId != android.view.Display.DEFAULT_DISPLAY || home == null
+                || !(original instanceof com.android.quickstep.LauncherActivityInterface)
+                || !home.hasExtra(PANEL_EXTRA)) return original;
+        return com.android.quickstep.LauncherActivityInterface.forPanel(home.getIntExtra(PANEL_EXTRA, 0));
+    }
+
+    /** Mutable pending-intent fill-in is copied so LEFT and RIGHT never mutate shared intents. */
+    public static android.content.Intent routeHomeIntent(android.content.Intent original,
+            android.app.ActivityOptions options) {
+        if (original == null || !com.android.launcher3.ZetaWorkspaceMode.enabled(
+                android.app.ActivityThread.currentApplication())) return original;
+        if (snapshot().getBoolean("lock_task", false)) return original;
+        android.content.ComponentName component = original.getComponent();
+        if (component == null || !(component.getClassName().equals(QuickstepLauncher.class.getName())
+                || component.getClassName().equals(ZetaRightHome.class.getName()))) return original;
+        int panel = original.getIntExtra(PANEL_EXTRA, sFocusedPanel);
+        if (panel != 0 && panel != 1) panel = 0;
+        android.content.Intent intent = new android.content.Intent(original);
+        intent.setComponent(new android.content.ComponentName(component.getPackageName(),
+                panel == 1 ? ZetaRightHome.class.getName() : QuickstepLauncher.class.getName()));
+        intent.putExtra(PANEL_EXTRA, panel);
+        if (options != null) options.setLaunchTaskDisplayAreaFeatureId(panel == 1
+                ? android.window.DisplayAreaOrganizer.FEATURE_VENDOR_FIRST + 10
+                : android.window.DisplayAreaOrganizer.FEATURE_DEFAULT_TASK_CONTAINER);
+        return intent;
+    }
+}
