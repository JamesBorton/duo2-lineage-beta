+    /** Bound the startup/recreation race without moving a task under a live leash. */
+    public void finishForWorkspaceToss(Runnable commit) {
+        long deadline = android.os.SystemClock.uptimeMillis() + 1000;
+        RecentsAnimationCallbacks expectedCallbacks = mCallbacks;
+        GestureState expectedState = mLastGestureState;
+        Runnable await = new Runnable() {
+            @Override public void run() {
+                if ((mCallbacks != null && mCallbacks != expectedCallbacks)
+                        || (mLastGestureState != null && mLastGestureState != expectedState)) return;
+                // ACTION_CANCEL starts a LAST_TASK settle animation in the swipe handler.
+                // Finishing the remote leash alone does not stop its later surface writes.
+                // Wait for that local animation as well before moving the task.
+                if (expectedState != null && !expectedState.hasState(
+                        GestureState.STATE_END_TARGET_ANIMATION_FINISHED
+                                | GestureState.STATE_RECENTS_SCROLLING_FINISHED)) {
+                    if (android.os.SystemClock.uptimeMillis() < deadline) {
+                        MAIN_EXECUTOR.getHandler().postDelayed(this, 16);
+                    } else {
+                        android.util.Log.w("ZetaToss", "Swipe settlement timed out; task unchanged");
+                    }
+                    return;
+                }
+                if (mController != null) {
+                    finishRunningRecentsAnimation(false, true, commit,
+                            new ActiveGestureLog.CompoundString("zeta app toss"));
+                } else if (!mRecentsAnimationStartPending) {
+                    commit.run();
+                } else if (android.os.SystemClock.uptimeMillis() < deadline) {
+                    MAIN_EXECUTOR.getHandler().postDelayed(this, 16);
+                } else {
+                    android.util.Log.w("ZetaToss", "Animation startup timed out; task unchanged");
+                }
+            }
+        };
+        await.run();
+    }
+
+    /** @return whether there is a recents animation running. */
     public boolean isRecentsAnimationRunning() {
         return mController != null;
     }
