diff --git a/src/com/android/launcher3/ZetaPanelOwnership.java b/src/com/android/launcher3/ZetaPanelOwnership.java
new file mode 100644
index 0000000000000000000000000000000000000000..9d5d1ca59097b5cca1f1399919cf89392e1b488d
--- /dev/null
+++ b/src/com/android/launcher3/ZetaPanelOwnership.java
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3;
+
+/** Stable physical panel ownership for the shared launcher model. No Android runtime dependency. */
+public final class ZetaPanelOwnership {
+    private ZetaPanelOwnership() { }
+
+    public static long cellContainerKey(int panel, int container) {
+        if (panel < 0 || panel > 1) throw new IllegalArgumentException("Invalid panel");
+        return ((long) panel << 32) | (container & 0xffffffffL);
+    }
+
+    public static boolean visibleTo(int panel, int itemPanel, int container) {
+        if (panel == -1) return true;
+        if (panel < 0 || panel > 1) throw new IllegalArgumentException("Invalid panel");
+        // Prediction and system containers are shared. Desktop (-100), dock (-101), and
+        // folder children (positive container IDs) retain explicit persistent ownership.
+        return itemPanel == panel || container < -101;
+    }
+}
