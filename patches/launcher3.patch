@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3;
+
+import android.content.Context;
+
+/** Process-stable workspace namespace. Switching mode requires a framework/launcher restart. */
+public final class ZetaWorkspaceMode {
+    public static final String DATABASE = "zeta_workspace_v1.db";
+    private static volatile Boolean sEnabled;
+    private ZetaWorkspaceMode() { }
+
+    public static boolean enabled(Context context) {
+        Boolean cached = sEnabled;
+        if (cached != null) return cached;
+        // ApiWrapper initialization may marshal to the main thread. Never hold a class lock
+        // while waiting for it: IDP/model creation can reach this method from either thread.
+        boolean enabled = context.getPackageManager().hasSystemFeature("org.lineageos.zeta.workspace")
+                && com.android.launcher3.util.ApiWrapper.INSTANCE.get(context)
+                        .isZetaWorkspaceEnabled();
+        synchronized (ZetaWorkspaceMode.class) {
+            if (sEnabled == null) sEnabled = enabled;
+            return sEnabled;
+        }
+    }
+
+    public static String preferenceFile(Context context, String original) {
+        return enabled(context) ? "zeta_workspace_v1_" + original : original;
+    }
+
+    public static int widgetHostId(Context context) { return enabled(context) ? 1025 : 1024; }
+}
