@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3;
+
+import java.util.ArrayDeque;
+
+/** Raw display coordinates; the target vector follows physical panels through rotation. */
+public final class ZetaTossGesture {
+    // Allow a continuous lift-and-turn without requiring a sub-second trick.
+    // A deliberate pause still belongs to Recents, not to a later toss.
+    private static final long MAX_DURATION_MS = 1200;
+    private static final long PAUSE_MS = 240;
+    private static final long VELOCITY_WINDOW_MS = 120;
+    private static final long RELEASE_GRACE_MS = 120;
+    private static final float MIN_SPEED_DP_PER_SECOND = 350;
+    private final float density, targetX, targetY, downY;
+    private final long downTime;
+    private final ArrayDeque<Sample> samples = new ArrayDeque<>();
+    private float anchorX, anchorY, motionX, motionY, lastX, lastY;
+    private float furthestAlong, speed;
+    private long lastTime, motionTime, qualifiedTime = -1;
+    private boolean lifted, cancelled, lateralHook;
+
+    private static final class Sample {
+        final float x, y;
+        final long time;
+        Sample(float x, float y, long time) { this.x = x; this.y = y; this.time = time; }
+    }
+
+    public ZetaTossGesture(float x, float y, long time, float density, float dx, float dy) {
+        this.density = density;
+        downY = y;
+        downTime = lastTime = motionTime = time;
+        lastX = motionX = anchorX = x;
+        lastY = motionY = anchorY = y;
+        float length = (float) Math.hypot(dx, dy);
+        targetX = length == 0 ? 0 : dx / length;
+        targetY = length == 0 ? 0 : dy / length;
+        cancelled = length == 0 || density <= 0;
+        samples.addLast(new Sample(x, y, time));
+    }
+
+    public void cancel() { cancelled = true; samples.clear(); }
+
+    public boolean update(float x, float y, long time) {
+        if (cancelled || time < lastTime || time - downTime > MAX_DURATION_MS
+                || (lifted && time - motionTime > PAUSE_MS)) {
+            cancel();
+            return false;
+        }
+        if (!lifted && downY - y >= 48 * density) {
+            lifted = true;
+            anchorX = x;
+            anchorY = y;
+        }
+        if (Math.hypot(x - motionX, y - motionY) >= 3 * density) {
+            motionTime = time;
+            motionX = x;
+            motionY = y;
+        }
+        // Average a bounded recent window instead of trusting one noisy MOVE or UP.
+        // Retain one sample before the boundary so sparse and dense input agree.
+        if (time > lastTime) samples.addLast(new Sample(x, y, time));
+        while (samples.size() > 2) {
+            Sample first = samples.removeFirst();
+            if (samples.peekFirst().time > time - VELOCITY_WINDOW_MS
+                    && samples.size() < 64) {
+                samples.addFirst(first);
+                break;
+            }
+        }
+        java.util.Iterator<Sample> history = samples.iterator();
+        Sample first = history.next();
+        float startX = first.x, startY = first.y;
+        long startTime = first.time;
+        long cutoff = time - VELOCITY_WINDOW_MS;
+        if (startTime < cutoff && history.hasNext()) {
+            Sample second = history.next();
+            if (second.time > startTime) {
+                float fraction = (float) (cutoff - startTime) / (second.time - startTime);
+                startX += fraction * (second.x - first.x);
+                startY += fraction * (second.y - first.y);
+                startTime = cutoff;
+            }
+        }
+        long dt = time - startTime;
+        if (dt > 0) speed = ((x - startX) * targetX + (y - startY) * targetY) * 1000 / dt;
+        float forwardStep = (x - lastX) * targetX + (y - lastY) * targetY;
+        lastX = x;
+        lastY = y;
+        lastTime = time;
+        lateralHook |= Math.abs(x - anchorX) >= 48 * density;
+        // A plain Home swipe points toward the other pane in stacked rotation.
+        if (targetY < -0.7f && !lateralHook) return false;
+        float along = (x - anchorX) * targetX + (y - anchorY) * targetY;
+        float across = Math.abs((x - anchorX) * targetY - (y - anchorY) * targetX);
+        furthestAlong = Math.max(furthestAlong, along);
+        if (qualifiedTime >= 0 && furthestAlong - along > 24 * density) {
+            cancel(); // A deliberate reversal withdraws the move proposal.
+            return false;
+        }
+        boolean directed = lifted && along >= 72 * density
+                && across <= Math.max(128 * density, 1.5f * along);
+        if (directed && forwardStep > 0 && speed >= MIN_SPEED_DP_PER_SECOND * density) {
+            qualifiedTime = time;
+        }
+        // A tiny release wobble need not defeat an otherwise deliberate toss.
+        // The proposal expires promptly; holding it is still a Recents gesture.
+        return directed && qualifiedTime >= 0 && time - qualifiedTime <= RELEASE_GRACE_MS;
+    }
+}
