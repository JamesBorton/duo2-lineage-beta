+        }
+    }
+
+    /** Button destinations are relative to the invoking Home, never cached task ownership. */
+    public static boolean canOpenRecentOnScreen(
+            com.android.quickstep.views.RecentsViewContainer container) {
+        if (!(container instanceof Launcher) || ((Launcher) container).getWorkspacePanelId() < 0) {
+            return false;
+        }
+        android.os.Bundle state = snapshot();
+        return state.getBoolean("enabled") && state.getInt("composition", -1) == 2
+                && !state.getBoolean("locked") && !state.getBoolean("lock_task")
+                && !state.getBoolean("switching");
+    }
+
+    /** Called after the live Recents animation has ended; moves and resumes the same task. */
+    public static void openRecentOnScreen(
+            com.android.quickstep.views.RecentsViewContainer container,
+            com.android.systemui.shared.recents.model.Task.TaskKey key, boolean otherScreen) {
+        if (!canOpenRecentOnScreen(container)) {
+            showScreenActionUnavailable();
+            return;
+        }
+        Launcher home = (Launcher) container;
+        int origin = home.getWorkspacePanelId();
+        int destination = otherScreen ? 1 - origin : origin;
+        android.app.ActivityOptions options = android.app.ActivityOptions.makeBasic();
+        options.setLaunchDisplayId(android.view.Display.DEFAULT_DISPLAY);
+        options.setLaunchWindowingMode(android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN);
+        if (!prepareRecentLaunchOnPanel(key, options, destination, true)) return;
+        try {
+            if (!com.android.systemui.shared.system.ActivityManagerWrapper.getInstance()
+                    .startActivityFromRecents(key, options)) {
+                showScreenActionUnavailable();
+                return;
+            }
+            com.android.quickstep.views.RecentsView recents = home.getOverviewPanel();
+            if (recents != null) recents.onRecentsAnimationComplete();
+            home.getStateManager().goToState(com.android.launcher3.LauncherState.NORMAL, false);
+            if (recents != null) recents.reset();
+            android.util.Log.i("ZetaWorkspace", "Recents button task=" + key.id
+                    + " origin=" + origin + " destination=" + destination);
+        } catch (RuntimeException error) {
+            android.util.Log.w("ZetaWorkspace", "Recents screen action unavailable", error);
+            showScreenActionUnavailable();
+        }
+    }
+
+    private static void showScreenActionUnavailable() {
+        android.widget.Toast.makeText(android.app.ActivityThread.currentApplication(),
+                com.android.launcher3.R.string.zeta_action_unavailable,
+                android.widget.Toast.LENGTH_SHORT).show();
+    }
+
+    /** A touched pane Home may be resumed before its window receives focus. */
+    public static boolean isCapturedHomeGesture(
+            com.android.quickstep.views.RecentsViewContainer container) {
+        return container instanceof Launcher && sGestureInRegion && sGestureTask != null
+                && sGestureTask.getActivityType() == android.app.WindowConfiguration.ACTIVITY_TYPE_HOME
+                && ((Launcher) container).getWorkspacePanelId() >= 0
+                && ((Launcher) container).getWorkspacePanelId() == sGestureTask.zetaWorkspacePanel;
+    }
