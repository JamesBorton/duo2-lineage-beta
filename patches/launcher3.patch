+                android.view.WindowManagerGlobal.getWindowManagerService().zetaWorkspaceAction(
+                        com.android.internal.zeta.ZetaWorkspaceProtocol.FOCUS, panel, -1);
+                state = snapshot();
+                sGestureTask = state.getParcelable(state.getInt("spanned_task", -1) >= 0
+                        ? "span_taskinfo" : "taskinfo_" + panel, android.app.ActivityManager.RunningTaskInfo.class);
+            } catch (android.os.RemoteException | IllegalStateException | IllegalArgumentException error) {
+                sGestureInRegion = false;
+            }
+        }
+    }
