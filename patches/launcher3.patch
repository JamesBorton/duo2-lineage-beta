diff --git a/quickstep/src/com/android/quickstep/util/ZetaAppPairs.java b/quickstep/src/com/android/quickstep/util/ZetaAppPairs.java
new file mode 100644
index 0000000000000000000000000000000000000000..bd6d5ceccaec99b4b4cc60572a53f4ed6905e239
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/ZetaAppPairs.java
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.quickstep.util;
+
+import android.app.ActivityManager;
+import android.app.ActivityOptions;
+import android.content.ComponentName;
+import android.content.pm.LauncherApps;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.view.WindowManagerGlobal;
+import android.widget.Toast;
+import com.android.launcher3.Launcher;
+import com.android.launcher3.LauncherAppState;
+import com.android.launcher3.R;
+import com.android.launcher3.model.data.AppInfo;
+import com.android.launcher3.model.data.AppPairInfo;
+import com.android.launcher3.model.data.WorkspaceItemInfo;
+import com.android.launcher3.util.ComponentKey;
+import java.util.List;
+import static com.android.launcher3.util.Executors.MAIN_EXECUTOR;
+import static com.android.launcher3.util.Executors.MODEL_EXECUTOR;
+
+/** Saved pairs reuse Launcher3's database/icon model, but launch into physical panel areas. */
+public final class ZetaAppPairs {
+    private ZetaAppPairs() { }
+    private static Bundle state() throws android.os.RemoteException {
+        Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+        if (state == null || !state.getBoolean("enabled") || state.getBoolean("locked")
+                || state.getBoolean("lock_task") || state.getBoolean("switching") || state.getInt("composition") != 2
+                || state.getInt("spanned_task", -1) >= 0) {
+            throw new IllegalStateException("Two unlocked panels are required");
+        }
+        return state;
+    }
+    private static AppInfo resolve(Launcher launcher, ActivityManager.RunningTaskInfo task) {
+        if (task == null) return null;
+        ComponentName component = task.realActivity != null ? task.realActivity
+                : task.baseIntent.getComponent();
+        if (component == null) return null;
+        ComponentKey key = new ComponentKey(component, UserHandle.of(task.userId));
+        var store = launcher.getAppsView().getAppsStore();
+        AppInfo info = store.getApp(key);
+        return info != null ? info : store.getApp(key, AppInfo.PACKAGE_KEY_COMPARATOR);
+    }
+    private static List<WorkspaceItemInfo> pair(Launcher launcher,
+            com.android.systemui.shared.recents.model.Task.TaskKey selected) throws android.os.RemoteException {
+        Bundle snapshot = state();
+        AppInfo left = resolve(launcher, snapshot.getParcelable("standard_taskinfo_0",
+                ActivityManager.RunningTaskInfo.class));
+        AppInfo right = resolve(launcher, snapshot.getParcelable("standard_taskinfo_1",
+                ActivityManager.RunningTaskInfo.class));
+        int owner = selected.zetaWorkspacePanel < 0 ? 0 : selected.zetaWorkspacePanel;
+        if (owner < 0 || owner > 1) throw new IllegalStateException("Task has no independent panel");
+        ComponentKey key = com.android.quickstep.TaskUtils.getLaunchComponentKeyForTask(selected);
+        var store = launcher.getAppsView().getAppsStore();
+        AppInfo chosen = store.getApp(key);
+        if (chosen == null) chosen = store.getApp(key, AppInfo.PACKAGE_KEY_COMPARATOR);
+        if (owner == 0) left = chosen; else right = chosen;
+        if (left == null || right == null || ((left.runtimeStatusFlags | right.runtimeStatusFlags)
+                & com.android.launcher3.model.data.ItemInfoWithIcon.FLAG_NOT_PINNABLE) != 0) {
+            throw new IllegalStateException("Apps must be launchable and pinnable");
+        }
+        // Do not duplicate singleton/shared-affinity apps through a launcher shortcut.
+        if (left.componentName.getPackageName().equals(right.componentName.getPackageName())
+                && left.user.equals(right.user)) throw new IllegalStateException("Distinct apps required");
+        return List.of(left.makeWorkspaceItem(launcher), right.makeWorkspaceItem(launcher));
+    }
+    public static boolean canSave(Launcher launcher,
+            com.android.systemui.shared.recents.model.Task.TaskKey selected) {
+        try { pair(launcher, selected); return true; }
+        catch (android.os.RemoteException | RuntimeException error) { return false; }
+    }
+    public static void save(Launcher launcher,
+            com.android.systemui.shared.recents.model.Task.TaskKey selected) {
+        try {
+            List<WorkspaceItemInfo> apps = pair(launcher, selected);
+            for (int i = 0; i < 2; i++) apps.get(i).rank = AppPairsController.encodeRank(
+                    com.android.wm.shell.shared.split.SplitScreenConstants.getIndex(i),
+                    com.android.wm.shell.shared.split.SplitScreenConstants.SNAP_TO_2_50_50);
+            AppPairInfo pair = new AppPairInfo(apps);
+            var cache = LauncherAppState.getInstance(launcher).getIconCache();
+            MODEL_EXECUTOR.execute(() -> {
+                pair.getAppContents().forEach(member -> {
+                    member.title = "";
+                    member.bitmap = cache.getDefaultIcon(member.user);
+                    cache.getTitleAndIcon(member, member.getMatchingLookupFlag());
+                });
+                MAIN_EXECUTOR.execute(() -> {
+                    if (!launcher.isDestroyed()) launcher.getAccessibilityDelegate()
+                            .addToWorkspace(pair, true, success -> { if (!success) unavailable(launcher); });
+                });
+            });
+        } catch (android.os.RemoteException | RuntimeException error) { unavailable(launcher); }
+    }
+    public static boolean launch(Launcher launcher, AppPairInfo pair) {
+        try {
+            state();
+            List<WorkspaceItemInfo> apps = List.of(pair.getFirstApp(), pair.getSecondApp());
+            LauncherApps service = launcher.getSystemService(LauncherApps.class);
+            for (WorkspaceItemInfo app : apps) {
+                if (app.intent.getComponent() == null || !service.isActivityEnabled(
+                        app.intent.getComponent(), app.user)) throw new IllegalStateException("Unavailable app");
+            }
+            if (apps.get(0).intent.getComponent().getPackageName().equals(
+                    apps.get(1).intent.getComponent().getPackageName())
+                    && apps.get(0).user.equals(apps.get(1).user)) {
+                throw new IllegalStateException("Distinct apps required");
+            }
+            for (int panel = 0; panel < 2; panel++) {
+                ActivityOptions options = ActivityOptions.makeBasic();
+                options.setLaunchDisplayId(android.view.Display.DEFAULT_DISPLAY);
+                options.setLaunchTaskDisplayAreaFeatureId(panel == 0
+                        ? android.window.DisplayAreaOrganizer.FEATURE_DEFAULT_TASK_CONTAINER
+                        : android.window.DisplayAreaOrganizer.FEATURE_VENDOR_FIRST + 10);
+                service.startMainActivity(apps.get(panel).intent.getComponent(), apps.get(panel).user,
+                        null, options.toBundle());
+            }
+            return true;
+        } catch (android.os.RemoteException | RuntimeException error) { unavailable(launcher); return false; }
+    }
+    private static void unavailable(Launcher launcher) {
+        Toast.makeText(launcher, R.string.zeta_pair_unavailable, Toast.LENGTH_LONG).show();
+    }
+}
