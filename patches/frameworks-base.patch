+        ResultReceiver remote=ResultReceiver.CREATOR.createFromParcel(parcel);parcel.recycle();
+        android.content.Intent intent=new android.content.Intent("org.lineageos.zeta.action.SCREEN_SELECTION")
+                .setPackage("org.lineageos.zeta.posturecontroller");
+        Bundle extras=new Bundle();extras.putBinder("owner",owner);
+        intent.putExtras(extras).putExtra("command",command).putExtra("side",side).putExtra("reply",remote);
+        context.sendBroadcast(intent);
+    }
+    private void finish(int side) {
