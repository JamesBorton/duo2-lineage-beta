+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.navigationbar.gestural;
+
+/** Pixel-only physical pane edge classification; exclusions remain in EdgeBackGestureHandler. */
+public final class ZetaBackGestureBounds {
+    private ZetaBackGestureBounds() { }
+    public static int edge(int x, int y, int left, int top, int right, int bottom,
+            int leftWidth, int rightWidth, int reservedBottom) {
+        if (left >= right || top >= bottom || leftWidth < 0 || rightWidth < 0 || reservedBottom < 0
+                || x < left || x >= right || y < top || y >= bottom - reservedBottom) return -1;
+        if (x < left + leftWidth) return 0;
+        if (x >= right - rightWidth) return 1;
+        return -1;
+    }
+}
