+                || view.getPaddingRight() != right || view.getPaddingBottom() != bottom) {
+            view.setPadding(left, top, right, bottom);
+        }
+        base[4] = left; base[5] = top; base[6] = right; base[7] = bottom;
+        return scoped;
+    }
+}
