+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.wm;
+
+/** Fold/span state independent of WM objects. All calls are serialized by the WM global lock. */
+public final class ZetaWorkspaceState {
+    public static final class Move {
+        public final int taskId;
+        public final int panel;
+        Move(int taskId, int panel) { this.taskId = taskId; this.panel = panel; }
+    }
+
+    private int mComposition = ZetaWorkspaceGeometry.SPAN;
+    private int mFocusedPanel = ZetaWorkspaceGeometry.LEFT;
+    private int mSpannedTask = -1;
+    private int mSpanOwner = ZetaWorkspaceGeometry.LEFT;
+    private int mParkedSpan = -1;
+
+    public int composition() { return mComposition; }
+    public int focusedPanel() { return mFocusedPanel; }
+    public int spannedTask() { return mSpannedTask; }
+    public int parkedSpan() { return mParkedSpan; }
+    public int spanOwner() { return mSpanOwner; }
+
+    public void focus(int panel, int taskId) {
+        requirePanel(panel);
+        if (panel != ZetaWorkspaceGeometry.SPAN) mFocusedPanel = panel;
+        // Returning to a different task/Home while folded is a user mode change.
+        if (mComposition != ZetaWorkspaceGeometry.SPAN && mParkedSpan != taskId) {
+            mParkedSpan = -1;
+        }
+    }
+
+    public Move span(int taskId, int owner) {
+        if (taskId < 0 || owner < 0 || owner > ZetaWorkspaceGeometry.RIGHT) {
+            throw new IllegalArgumentException("Invalid span task/owner");
+        }
+        if (mComposition != ZetaWorkspaceGeometry.SPAN || mSpannedTask >= 0) {
+            throw new IllegalStateException("Span requires dual mode with no existing span");
+        }
+        mSpannedTask = taskId;
+        mSpanOwner = owner;
+        mParkedSpan = -1;
+        return new Move(taskId, ZetaWorkspaceGeometry.SPAN);
+    }
+
+    public Move unspan() {
+        Move move = mSpannedTask >= 0 ? new Move(mSpannedTask, mSpanOwner) : null;
+        mSpannedTask = -1;
+        mParkedSpan = -1;
+        return move;
+    }
+
+    public Move composition(int value) {
+        requirePanel(value);
+        if (value == mComposition) return null;
+        mComposition = value;
+        if (value != ZetaWorkspaceGeometry.SPAN) {
+            mFocusedPanel = value;
+            if (mSpannedTask >= 0) {
+                mParkedSpan = mSpannedTask;
+                mSpannedTask = -1;
+            }
+            return mParkedSpan >= 0 ? new Move(mParkedSpan, value) : null;
+        }
+        if (mParkedSpan >= 0) {
+            mSpannedTask = mParkedSpan;
+            mParkedSpan = -1;
+            return new Move(mSpannedTask, ZetaWorkspaceGeometry.SPAN);
+        }
+        return null;
+    }
+
+    public void taskRemoved(int taskId) {
+        if (taskId == mSpannedTask) mSpannedTask = -1;
+        if (taskId == mParkedSpan) mParkedSpan = -1;
+    }
+
+    private static void requirePanel(int panel) {
+        if (!ZetaWorkspaceGeometry.validPanel(panel)) {
+            throw new IllegalArgumentException("Invalid panel");
+        }
+    }
+}
