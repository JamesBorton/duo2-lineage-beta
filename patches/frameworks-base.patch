+    /** Synthetic counterpart of the phone viewport bridge; reached only by QEMU actions. */
+    private void emulatorSelectionComposition(int mode) {
+        setComposition(mode);
+        service.setForcedDisplaySize(android.view.Display.DEFAULT_DISPLAY,
+                mode == 2 ? ZetaWorkspaceGeometry.WIDTH : ZetaWorkspaceGeometry.PANEL_WIDTH,
+                ZetaWorkspaceGeometry.HEIGHT);
+    }
+
+    void action(int action, int panel, int taskId) {
+        if (action >= 100 && action <= 102) {
+            if (!SystemProperties.getBoolean("ro.kernel.qemu", false)
+                    && !SystemProperties.getBoolean("ro.boot.qemu", false)) throw new SecurityException("Emulator only");
+            if (!"lineage_zeta_workspace_emu".equals(SystemProperties.get("ro.product.name"))) throw new SecurityException("Emulator product only");
+            if (action == 100) {
+                if (switching || state.composition() == 2 || snapshot().getBoolean("locked")
+                        || snapshot().getBoolean("lock_task")) throw new IllegalStateException("Unavailable selection");
+                mEmulatorSwitchSource = state.composition(); setSwitching(true); emulatorSelectionComposition(2);
+                final int generation = ++mEmulatorSwitchGeneration;
+                service.mH.postDelayed(() -> {
+                    synchronized (service.mGlobalLock) {
+                        if (generation == mEmulatorSwitchGeneration && switching && mEmulatorSwitchSource >= 0) {
+                            emulatorSelectionComposition(mEmulatorSwitchSource); setSwitching(false); mEmulatorSwitchSource=-1;
+                        }
+                    }
+                }, 5500);
+            } else {
+                int target = action == 101 ? panel : mEmulatorSwitchSource;
+                if (target < 0 || target > 1) throw new IllegalArgumentException("Invalid selection");
+                ++mEmulatorSwitchGeneration;
+                emulatorSelectionComposition(target); setSwitching(false); mEmulatorSwitchSource = -1;
+            }
+            return;
+        }
+        switch (action) {
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.MOVE: moveTask(taskId, panel); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.SPAN: spanTask(taskId); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.UNSPAN: unspanTask(); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.SWAP: swapTasks(); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.HOME: home(panel); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.FOCUS: focusPanel(panel); break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.PREPARE_RECENTS:
+                prepareOverview(panel);
+                break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.OVERVIEW:
+                prepareOverview(panel);
+                service.mAtmService.mRootWindowContainer.startHomeOnTaskDisplayArea(
+                        service.mAtmService.mAmInternal.getCurrentUserId(), "zeta-workspace-overview",
+                        areas[panel], false, false);
+                Task homeTask = areas[panel].getRootHomeTask();
+                ActivityRecord home = homeTask == null ? null : homeTask.getTopNonFinishingActivity();
+                if (home != null) {
+                    android.content.Intent overview = new android.content.Intent(home.intent)
+                            .putExtra("org.lineageos.zeta.workspace.OVERVIEW", true)
+                            .putExtra("org.lineageos.zeta.workspace.PANEL", panel);
+                    home.deliverNewIntentLocked(android.os.Process.SYSTEM_UID, overview, null,
+                            "android", false, home.mUserId,
+                            android.os.UserHandle.getAppId(home.info.applicationInfo.uid));
+                }
+                break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.SHADE_ORIGIN:
+                enforceTaskManagementAllowed();
+                if (!mShadeVisible && !service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)
+                        && panel >= 0 && panel < 2 && (state.composition() == 2 || state.composition() == panel)) {
+                    mShadePanel = panel;
+                }
+                break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.SHADE_BEGIN:
+                enforceTaskManagementAllowed();
+                if (!service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)) {
+                    if (mShadePanel < 0 || (state.composition() != 2 && state.composition() != mShadePanel)) {
+                        mShadePanel = state.composition() == 2 ? state.focusedPanel() : state.composition();
+                    }
+                    mShadeVisible = true;
+                    updateShadeConfiguration();
+                }
+                break;
+            case com.android.internal.zeta.ZetaWorkspaceProtocol.SHADE_END:
+                mShadeVisible = false;
+                mShadePanel = -1;
+                updateShadeConfiguration();
+                break;
+            default: throw new IllegalArgumentException("Unknown workspace action");
+        }
+    }
+
+    void focusPanel(int panel) {
+        enforceTaskManagementAllowed();
+        if (panel < 0 || panel > 1 || (state.composition() != 2
+                && state.composition() != panel)) throw new IllegalArgumentException("Hidden panel");
+        Task top = state.spannedTask() >= 0 ? attachedTask(state.spannedTask())
+                : areas[panel].getTopMostTask();
+        state.focus(panel, top == null ? -1 : top.mTaskId);
+        if (top != null) top.moveToFront("zeta-workspace-focus");
+        refresh();
+        service.updateFocusedWindowLocked(WindowManagerService.UPDATE_FOCUS_NORMAL, true);
+    }
+
+    private boolean independentBars() {
+        return !service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)
+                && !service.mAtmService.getLockTaskController().isZetaTaskManagementRestricted();
+    }
+
+    private static int navigationPanel(WindowState window) {
+        if (window == null || window.mAttrs.type != android.view.WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL) return -1;
+        for (int panel = 0; panel < 2; panel++) {
+            if (("Zeta navigation " + panel).contentEquals(window.mAttrs.getTitle())) return panel;
+        }
+        return -1;
+    }
+
+    private WindowState paneMainWindow(int panel) {
+        Task span = state.spannedTask() >= 0 ? attachedTask(state.spannedTask()) : null;
+        ActivityRecord activity = span != null ? span.topRunningActivity() : areas[panel].topRunningActivity();
+        return activity == null ? null : activity.findMainWindow();
+    }
+
+    InsetsControlTarget navigationTarget(InsetsSourceProvider provider, InsetsControlTarget fallback) {
+        int panel = navigationPanel(provider.mWin);
+        if (panel < 0 || !independentBars() || !areas[panel].workspaceVisible()
+                && state.spannedTask() < 0) return fallback;
+        WindowState target = InsetsControlTarget.asWindowOrNull(fallback);
+        if (target != null) {
+            Task task = target.getTask();
+            if (mShadeVisible && mShadePanel == panel
+                    && target.mAttrs.type == android.view.WindowManager.LayoutParams.TYPE_NOTIFICATION_SHADE) return fallback;
+            if (task != null && task.getDisplayArea() == areas[panel]) return fallback;
+            if (task != null && task.getDisplayArea() == areas[ZetaWorkspaceGeometry.SPAN]) return fallback;
+        } else if (fallback == display.getInsetsPolicy().getShowingTransientControlTarget()
+                && state.focusedPanel() == panel) return fallback;
+        WindowState own = paneMainWindow(panel);
+        return own != null ? own : fallback;
+    }
+
+    InsetsControlTarget sharedStatusTarget(InsetsControlTarget fallback) {
+        if (!independentBars() || state.composition() != 2 || state.spannedTask() >= 0) return fallback;
+        WindowState target = InsetsControlTarget.asWindowOrNull(fallback);
+        if (target == null || target.getTask() == null
+                || !(target.getTask().getDisplayArea() instanceof ZetaTaskDisplayArea)
+                || target.isRequestedVisible(android.view.WindowInsets.Type.statusBars())) return fallback;
+        // Status is one shared surface, like Android multi-window. One immersive
+        // app cannot remove the bar or resize the other pane which still uses it.
+        for (int panel = 0; panel < 2; panel++) {
+            WindowState own = paneMainWindow(panel);
+            if (own != null && own.isRequestedVisible(android.view.WindowInsets.Type.statusBars())) return own;
+        }
+        return fallback;
+    }
+
+    android.view.InsetsState adjustInsets(WindowState window, android.view.InsetsState insets) {
+        Task task = window.getTask();
+        boolean panelApp = task != null && task.getDisplayArea() instanceof ZetaTaskDisplayArea;
+        boolean paneShade = window.mAttrs.type == android.view.WindowManager.LayoutParams.TYPE_NOTIFICATION_SHADE
+                && mShadeVisible && !service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId);
+        if (!panelApp && !paneShade) return insets;
+        android.graphics.Rect bounds = window.getBounds();
+        android.view.InsetsState adjusted = insets;
+        ZetaTaskDisplayArea taskArea = panelApp ? (ZetaTaskDisplayArea) task.getDisplayArea() : null;
+        int owner = taskArea != null ? taskArea.panel : mShadePanel;
+        android.graphics.Rect visibilityBounds = taskArea != null && owner != ZetaWorkspaceGeometry.SPAN
+                ? taskArea.getBounds() : bounds;
+        if (independentBars()) {
+            for (int i = insets.sourceSize() - 1; i >= 0; i--) {
+                android.view.InsetsSource source = insets.sourceAt(i);
+                if (source.getType() != android.view.WindowInsets.Type.navigationBars()
+                        && source.getType() != android.view.WindowInsets.Type.tappableElement()) continue;
+                InsetsSourceProvider provider = display.getInsetsStateController().getSourceProviders().get(source.getId());
+                if (provider == null || provider.mWin == null) continue;
+                int sourcePanel = navigationPanel(provider.mWin);
+                boolean remove = sourcePanel >= 0 && owner != ZetaWorkspaceGeometry.SPAN && sourcePanel != owner;
+                remove |= provider.mWin.mAttrs.type == android.view.WindowManager.LayoutParams.TYPE_NAVIGATION_BAR;
+                if (!remove && sourcePanel >= 0 && source.getType() == android.view.WindowInsets.Type.tappableElement()
+                        && provider.mWin.mAttrs.providedInsets != null) {
+                    for (android.view.InsetsFrameProvider provided : provider.mWin.mAttrs.providedInsets) {
+                        if (provided.getType() != android.view.WindowInsets.Type.navigationBars()) continue;
+                        android.view.InsetsSource navigation = insets.peekSource(provided.getId());
+                        remove |= navigation != null && !navigation.isVisible();
+                    }
+                }
+                if (remove) {
+                    if (adjusted == insets) adjusted = new android.view.InsetsState(insets, true);
+                    adjusted.removeSource(source.getId());
+                }
+            }
+        }
+        android.view.InsetsSource caption = insets.peekSource(android.view.InsetsSource.ID_IME_CAPTION_BAR);
+        if (caption != null && !caption.getFrame().isEmpty()
+                && !android.graphics.Rect.intersects(bounds, caption.getFrame())) {
+            adjusted = new android.view.InsetsState(insets, true);
+            adjusted.removeSource(android.view.InsetsSource.ID_IME_CAPTION_BAR);
+        }
+        android.view.InsetsSource ime = insets.peekSource(android.view.InsetsSource.ID_IME);
+        if (ime != null && ime.isVisible() && !android.graphics.Rect.intersects(visibilityBounds, ime.getFrame())) {
+            if (adjusted == insets) adjusted = new android.view.InsetsState(insets, true);
+            adjusted.removeSource(android.view.InsetsSource.ID_IME);
+        }
+        if (!panelApp || ((ZetaTaskDisplayArea) task.getDisplayArea()).panel != ZetaWorkspaceGeometry.SPAN) return adjusted;
+        if (ime == null || !ime.isVisible()) return adjusted;
+        android.graphics.Rect frame = ime.getFrame();
+        ZetaWorkspaceGeometry.Bounds safe = ZetaWorkspaceGeometry.conservativeImeFrame(
+                new ZetaWorkspaceGeometry.Bounds(bounds.left, bounds.top, bounds.right, bounds.bottom),
+                new ZetaWorkspaceGeometry.Bounds(frame.left, frame.top, frame.right, frame.bottom));
+        if (safe == null) return adjusted;
+        if (adjusted == insets) adjusted = new android.view.InsetsState(insets, true);
+        android.view.InsetsSource safeIme = new android.view.InsetsSource(ime);
+        safeIme.setFrame(safe.left, safe.top, safe.right, safe.bottom);
+        if (ime.getVisibleFrame() != null) safeIme.setVisibleFrame(new android.graphics.Rect(
+                safe.left, safe.top, safe.right, safe.bottom));
+        adjusted.addSource(safeIme);
+        return adjusted;
+    }
+
+    /** One credential-pane authority shared by SystemUI and the secure IME. */
+    int keyguardPanel() {
+        return state.composition() == ZetaWorkspaceGeometry.SPAN
+                ? ZetaWorkspaceGeometry.RIGHT : state.composition();
+    }
+
+    android.graphics.Rect imeBounds(int rotation) {
+        int panel = state.focusedPanel();
+        InputTarget target = display.getImeInputTarget();
+        ActivityRecord activity = target == null ? null : target.getActivityRecord();
+        if (service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)) {
+            panel = keyguardPanel(); // Stable default; backdrop touches cannot move credentials.
+        } else if (activity != null && activity.getDisplayArea() instanceof ZetaTaskDisplayArea) {
+            int owner = ((ZetaTaskDisplayArea) activity.getDisplayArea()).panel;
+            if (owner != ZetaWorkspaceGeometry.SPAN) panel = owner;
+        }
+        ZetaWorkspaceGeometry.Bounds b = ZetaWorkspaceGeometry.bounds(
+                panel, state.composition(), rotation);
+        return new android.graphics.Rect(b.left, b.top, b.right, b.bottom);
+    }
+
+    void notifyWorkspaceUi() {
+        service.mH.post(() -> service.mContext.sendBroadcastAsUser(
+                new android.content.Intent("org.lineageos.zeta.WORKSPACE_CHANGED")
+                        .setPackage("com.android.systemui"), android.os.UserHandle.ALL,
+                android.Manifest.permission.MANAGE_ACTIVITY_TASKS));
+    }
+
+    android.graphics.Rect shadeBounds(int rotation) {
+        if (!mShadeVisible || service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)
+                || service.mAtmService.getLockTaskController().isZetaTaskManagementRestricted()) return null;
+        int panel = state.composition() == 2 ? mShadePanel : state.composition();
+        if (panel < 0 || panel > 1) return null;
+        ZetaWorkspaceGeometry.Bounds bounds = ZetaWorkspaceGeometry.bounds(panel, state.composition(), rotation);
+        return new android.graphics.Rect(bounds.left, bounds.top, bounds.right, bounds.bottom);
+    }
+
+    void updateShadeConfiguration() {
+        if (service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)) {
+            mShadeVisible = false;
+            mShadePanel = -1;
+        }
+        display.forAllWindows(win -> {
+            if (win.mAttrs.type == android.view.WindowManager.LayoutParams.TYPE_NOTIFICATION_SHADE
+                    && win.mToken.getParent() != null) {
+                win.mToken.onConfigurationChanged(win.mToken.getParent().getConfiguration());
+            }
+        }, true);
+        display.setLayoutNeeded();
+        service.requestTraversal();
+    }
+
+    void updateImeConfiguration() {
+        WindowState ime = display.mInputMethodWindow;
+        if (ime != null && ime.mToken.getParent() != null) {
+            ime.mToken.onConfigurationChanged(ime.mToken.getParent().getConfiguration());
+        }
+    }
+
+    void touch(android.view.MotionEvent event) {
+        if (event.getActionMasked() != android.view.MotionEvent.ACTION_DOWN) return;
+        final int x = (int) event.getX(), y = (int) event.getY();
+        service.mH.post(() -> {
+            synchronized (service.mGlobalLock) {
+                int panel = ZetaWorkspaceGeometry.panelAt(x, y, state.composition(), display.getRotation());
+                if (panel < 0 || panel == state.focusedPanel()) return;
+                Task focused = display.mFocusedApp == null ? null : display.mFocusedApp.getTask();
+                state.focus(panel, focused == null ? -1 : focused.mTaskId);
+                updateImeConfiguration();
+                notifyWorkspaceUi();
+                display.setLayoutNeeded();
+                service.requestTraversal();
+            }
+        });
+    }
+
+    public static final class Provider extends DisplayAreaPolicy.DefaultProvider {
+        public Provider(){}
+        @Override List<TaskDisplayArea> createTaskDisplayAreas(WindowManagerService service,DisplayContent display){
+            if(!enabled(service,display))return super.createTaskDisplayAreas(service,display);
+            ZetaWorkspacePolicy policy=new ZetaWorkspacePolicy(service,display);
+            display.mZetaWorkspacePolicy=policy;
+            display.registerPointerEventListener(policy::touch);
+            List<TaskDisplayArea> result=new ArrayList<>();
+            policy.areas[0]=new ZetaTaskDisplayArea(service,policy,0,"ZetaLeft",DisplayAreaOrganizer.FEATURE_DEFAULT_TASK_CONTAINER,true);
+            policy.areas[1]=new ZetaTaskDisplayArea(service,policy,1,"ZetaRight",FEATURE_RIGHT,true);
+            policy.areas[2]=new ZetaTaskDisplayArea(service,policy,2,"ZetaSpan",FEATURE_SPAN,false);
+            for(ZetaTaskDisplayArea area:policy.areas) {
+                area.setIgnoreOrientationRequest(true);
+                result.add(area);
+            }
+            Slog.i("ZetaWorkspace","Independent task areas enabled");
+            return result;
+        }
+    }
+}
