index 0000000000000000000000000000000000000000..e46d4ccf019bd9753cafbfdfebed39a1b7b6fe0c
--- /dev/null
+++ b/services/core/java/com/android/server/wm/ZetaWorkspaceGeometry.java
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.wm;
+
+/** Pure pixel geometry; independent of Android services so all rotations can be host-tested. */
+public final class ZetaWorkspaceGeometry {
+    public static final int LEFT=0, RIGHT=1, SPAN=2;
+    public static final int PANEL_WIDTH=1344, HEIGHT=1892, GAP=66, WIDTH=2754;
+    public static final class Bounds {
+        public final int left,top,right,bottom;
+        Bounds(int l,int t,int r,int b){left=l;top=t;right=r;bottom=b;}
+        public int width(){return right-left;}
+        public int height(){return bottom-top;}
+        public boolean contains(int x,int y){return x>=left&&x<right&&y>=top&&y<bottom;}
+        @Override public String toString(){return left+","+top+","+right+","+bottom;}
+    }
+    private ZetaWorkspaceGeometry(){}
+    public static boolean validPanel(int panel){return panel>=LEFT&&panel<=SPAN;}
+    public static Bounds bounds(int panel,int composition,int rotation){
+        if(!validPanel(panel)||!validPanel(composition)||rotation<0||rotation>3)
+            throw new IllegalArgumentException("Invalid panel/composition/rotation");
+        final boolean single=composition!=SPAN;
+        final int canvasWidth=single?PANEL_WIDTH:WIDTH;
+        Bounds b;
+        if(single || panel==SPAN)b=new Bounds(0,0,canvasWidth,HEIGHT);
+        else b=panel==LEFT?new Bounds(0,0,PANEL_WIDTH,HEIGHT):new Bounds(PANEL_WIDTH+GAP,0,WIDTH,HEIGHT);
+        return rotate(b,canvasWidth,HEIGHT,rotation);
+    }
+    public static Bounds hinge(int rotation){
+        if(rotation<0||rotation>3)throw new IllegalArgumentException("Invalid rotation");
+        return rotate(new Bounds(PANEL_WIDTH,0,PANEL_WIDTH+GAP,HEIGHT),WIDTH,HEIGHT,rotation);
+    }
+    public static int panelAt(int x,int y,int composition,int rotation){
+        if(composition!=SPAN)return bounds(composition,composition,rotation).contains(x,y)?composition:-1;
+        if(bounds(LEFT,SPAN,rotation).contains(x,y))return LEFT;
+        if(bounds(RIGHT,SPAN,rotation).contains(x,y))return RIGHT;
+        return -1;
+    }
+    /** Safe bottom inset for a spanning window when its keyboard occupies an upper panel. */
+    public static Bounds conservativeImeFrame(Bounds window, Bounds ime) {
+        if (window.width() <= 0 || window.height() <= 0 || ime.width() <= 0 || ime.height() <= 0) return null;
+        if (window.left >= ime.right || ime.left >= window.right
+                || window.top >= ime.bottom || ime.top >= window.bottom) return null;
+        return new Bounds(window.left, Math.max(window.top, ime.top), window.right, window.bottom);
+    }
+
+    /** Includes touchable inner-edge bands because the physical hinge cannot receive touch. */
+    public static int dropTarget(int x, int y, int composition, int rotation, int hingeSlop) {
+        if (hingeSlop < 0 || hingeSlop > PANEL_WIDTH / 2) {
+            throw new IllegalArgumentException("Invalid hinge target slop");
+        }
+        if (!bounds(SPAN, composition, rotation).contains(x, y)) return -1;
+        if (composition != SPAN) return composition;
+        Bounds h = hinge(rotation);
+        Bounds target = rotation % 2 == 0
+                ? new Bounds(h.left - hingeSlop, h.top, h.right + hingeSlop, h.bottom)
+                : new Bounds(h.left, h.top - hingeSlop, h.right, h.bottom + hingeSlop);
+        return target.contains(x, y) ? SPAN : panelAt(x, y, composition, rotation);
+    }
+
+    private static Bounds rotate(Bounds b,int w,int h,int r){
+        switch(r){
+            case 0:return b;
+            case 1:return new Bounds(b.top,w-b.right,b.bottom,w-b.left);
+            case 2:return new Bounds(w-b.right,h-b.bottom,w-b.left,h-b.top);
+            case 3:return new Bounds(h-b.bottom,b.left,h-b.top,b.right);
+            default:throw new IllegalArgumentException("Invalid rotation");
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/wm/ZetaWorkspacePolicy.java b/services/core/java/com/android/server/wm/ZetaWorkspacePolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..06a199c6dae6c2e5b9e218e5da3a9841f63c70f3
--- /dev/null
+++ b/services/core/java/com/android/server/wm/ZetaWorkspacePolicy.java
@@ -0,0 +1,718 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.wm;
+
+import android.content.res.Configuration;
+import android.os.SystemProperties;
+import android.provider.Settings;
+import android.util.Slog;
+import android.window.DisplayAreaOrganizer;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Device-only, policy-gated task areas. No synthetic physical displays or vendor image changes. */
+final class ZetaWorkspacePolicy {
+    static final String FEATURE="org.lineageos.zeta.workspace";
+    static final String ENABLED="zeta_workspace_enabled";
+    static final int FEATURE_RIGHT=DisplayAreaOrganizer.FEATURE_VENDOR_FIRST+10;
+    static final int FEATURE_SPAN=DisplayAreaOrganizer.FEATURE_VENDOR_FIRST+11;
+    final WindowManagerService service;
+    final DisplayContent display;
+    final ZetaTaskDisplayArea[] areas=new ZetaTaskDisplayArea[3];
+    final ZetaWorkspaceState state = new ZetaWorkspaceState();
+    boolean switching;
+    private int mEmulatorSwitchSource = -1;
+    private int mEmulatorSwitchGeneration;
+    void setSwitching(boolean value) { switching = value; refresh(); }
+    private boolean mTaskDragActive;
+    private boolean mHomeRepairPosted;
+    private int mShadePanel = -1;
+    private boolean mShadeVisible;
+    private boolean mSetupComplete;
+    boolean setupComplete() { return mSetupComplete; }
+
+    ZetaWorkspacePolicy(WindowManagerService service,DisplayContent display){
+        this.service=service;this.display=display;
+        mSetupComplete=readSetupComplete();
+        android.database.ContentObserver observer=new android.database.ContentObserver(service.mH) {
+            @Override public void onChange(boolean selfChange) {
+                synchronized(service.mGlobalLock) {
+                    if(get(display)!=ZetaWorkspacePolicy.this)return;
+                    boolean complete=readSetupComplete();
+                    if(complete==mSetupComplete)return;
+                    mSetupComplete=complete;
+                    Slog.i("ZetaWorkspace","Setup layout complete="+complete);
+                    refresh();
+                    if(complete)service.mAtmService.mRootWindowContainer.startHomeOnEmptyDisplays("zeta-setup-complete");
+                }
+            }
+        };
+        service.mContext.getContentResolver().registerContentObserver(Settings.Global.getUriFor(
+                Settings.Global.DEVICE_PROVISIONED),false,observer,android.os.UserHandle.USER_ALL);
+        service.mContext.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(
+                Settings.Secure.USER_SETUP_COMPLETE),false,observer,android.os.UserHandle.USER_ALL);
+    }
+    private boolean readSetupComplete() {
+        return Settings.Global.getInt(service.mContext.getContentResolver(),
+                Settings.Global.DEVICE_PROVISIONED,0)!=0
+                && Settings.Secure.getIntForUser(service.mContext.getContentResolver(),
+                        Settings.Secure.USER_SETUP_COMPLETE,0,
+                        service.mAtmService.mAmInternal.getCurrentUserId())!=0;
+    }
+    static boolean enabled(WindowManagerService service,DisplayContent display){
+        if(!display.isDefaultDisplay || SystemProperties.getBoolean("ro.boot.zeta_workspace_safe",false)
+                || !service.mContext.getPackageManager().hasSystemFeature(FEATURE))return false;
+        final long identity = android.os.Binder.clearCallingIdentity();
+        try {
+            boolean def=service.mContext.getResources().getBoolean(com.android.internal.R.bool.config_zetaWorkspaceDefaultEnabled);
+            if (Settings.Global.getInt(service.mContext.getContentResolver(),ENABLED,def?1:0) != 1) return false;
+            if (Settings.Global.getInt(service.mContext.getContentResolver(),
+                    Settings.Global.DEVICE_PROVISIONED, 0) != 0) {
+                // Generic intent resolution can retain a legacy preferred activity
+                // after ROLE_HOME changes. Read the selected role package as well.
+                // RoleService starts before WMS and its DE role state is available
+                // before credential unlock; keep both direct-boot flags below.
+                android.app.role.RoleManager roles = service.mContext.getSystemService(
+                        android.app.role.RoleManager.class);
+                java.util.List<String> holders = roles == null ? java.util.Collections.emptyList()
+                        : roles.getRoleHoldersAsUser(android.app.role.RoleManager.ROLE_HOME,
+                                android.os.UserHandle.of(service.mAtmService.mAmInternal.getCurrentUserId()));
+                if (holders.size() != 1 || !"com.android.launcher3".equals(holders.get(0))) {
+                    Slog.w("ZetaWorkspace", "Unsupported/unresolved Home role; using classic policy");
+                    return false;
+                }
+                android.content.Intent home = new android.content.Intent(android.content.Intent.ACTION_MAIN)
+                        .addCategory(android.content.Intent.CATEGORY_HOME);
+                android.content.pm.ResolveInfo info = service.mContext.getPackageManager().resolveActivityAsUser(home,
+                        android.content.pm.PackageManager.MATCH_DEFAULT_ONLY
+                                | android.content.pm.PackageManager.MATCH_DIRECT_BOOT_AWARE
+                                | android.content.pm.PackageManager.MATCH_DIRECT_BOOT_UNAWARE,
+                        service.mAtmService.mAmInternal.getCurrentUserId());
+                if (info == null || info.activityInfo == null
+                        || !"com.android.launcher3".equals(info.activityInfo.packageName)
+                        || !"com.android.launcher3.uioverrides.QuickstepLauncher".equals(info.activityInfo.name)) {
+                    Slog.w("ZetaWorkspace", "Incompatible/unresolved Home; using classic policy");
+                    return false;
+                }
+            }
+            return true;
+        }catch(RuntimeException error){Slog.e("ZetaWorkspace","Unavailable setting; classic policy",error);return false;}
+        finally { android.os.Binder.restoreCallingIdentity(identity); }
+    }
+    static ZetaWorkspacePolicy get(DisplayContent display){return display==null?null:display.mZetaWorkspacePolicy;}
+    static boolean hidden(Task task){
+        if(task==null)return false;
+        TaskDisplayArea area=task.getDisplayArea();
+        if (!(area instanceof ZetaTaskDisplayArea)) return false;
+        ZetaTaskDisplayArea panel = (ZetaTaskDisplayArea) area;
+        return !panel.workspaceVisible() || !panel.workspace.service.mAtmService.getLockTaskController()
+                .isTaskVisibleInZetaWorkspace(task);
+    }
+    TaskDisplayArea launchArea() {
+        if(!mSetupComplete)return areas[0];
+        return areas[state.composition() == ZetaWorkspaceGeometry.SPAN
+                ? state.focusedPanel() : state.composition()];
+    }
+
+    void onFocus(ActivityRecord activity) {
+        if (activity != null && activity.getDisplayArea() instanceof ZetaTaskDisplayArea) {
+            ZetaTaskDisplayArea area = (ZetaTaskDisplayArea) activity.getDisplayArea();
+            Task task = activity.getTask();
+            if (area.workspaceVisible()) {
+                int previous = state.focusedPanel();
+                state.focus(area.panel, task == null ? -1 : task.mTaskId);
+                updateImeConfiguration();
+                if (previous != state.focusedPanel()) notifyWorkspaceUi();
+            }
+        }
+    }
+
+    void onTaskRemoved(Task task) {
+        state.taskRemoved(task.mTaskId);
+        display.setLayoutNeeded();
+        service.requestTraversal();
+        if (task.isActivityTypeHome() && !mHomeRepairPosted) {
+            mHomeRepairPosted = true;
+            service.mH.post(() -> {
+                synchronized (service.mGlobalLock) {
+                    mHomeRepairPosted = false;
+                    int user = service.mAtmService.mAmInternal.getCurrentUserId();
+                    if (ZetaWorkspacePolicy.get(display) != this
+                            || !service.mAtmService.mAmInternal.isUserRunning(user,
+                                    android.app.ActivityManager.FLAG_AND_UNLOCKED)) return;
+                    // FallbackHome can finish after the other pane became focused.
+                    // Native focused-area resumption then leaves this pane empty.
+                    // Repair only empty, visible areas; never cover a running app.
+                    for (int panel = 0; panel < 2; panel++) {
+                        if (areas[panel].workspaceVisible() && areas[panel].topRunningActivity() == null) {
+                            service.mAtmService.mRootWindowContainer.startHomeOnTaskDisplayArea(
+                                    user, "zeta-empty-home-after-unlock", areas[panel], false, false);
+                        }
+                    }
+                }
+            });
+        }
+    }
+
+    void setComposition(int value) {
+        if (value == state.composition()) return;
+        applyMove(state.composition(value));
+        LockTaskController lock = service.mAtmService.getLockTaskController();
+        Task locked = lock.getZetaSecurityTask();
+        if (lock.isZetaTaskManagementRestricted()
+                && value != ZetaWorkspaceGeometry.SPAN && locked != null
+                && locked.getDisplayArea() instanceof ZetaTaskDisplayArea
+                && locked.getDisplayArea() != areas[value]) {
+            locked.reparent(areas[value], true);
+            state.focus(value, locked.mTaskId);
+        }
+        refresh();
+    }
+
+    private Task attachedTask(int id) {
+        Task task = service.mAtmService.mRootWindowContainer.anyTaskForId(id,
+                RootWindowContainer.MATCH_ATTACHED_TASK_ONLY);
+        if (task == null || !(task.getDisplayArea() instanceof ZetaTaskDisplayArea)
+                || task.getDisplayContent() != display || !task.isActivityTypeStandard()
+                || task.inPinnedWindowingMode()) {
+            throw new IllegalArgumentException("Task must be an attached standard workspace task");
+        }
+        return task;
+    }
+
+    private Task actionTask(int id) {
+        RootWindowContainer root = service.mAtmService.mRootWindowContainer;
+        Task task = root.anyTaskForId(id, RootWindowContainer.MATCH_ATTACHED_TASK_OR_RECENT_TASKS);
+        if (task == null || !service.mAtmService.mAmInternal.isCurrentProfile(task.mUserId)
+                || !task.isActivityTypeStandardOrUndefined() || task.inPinnedWindowingMode()) {
+            throw new IllegalArgumentException("Task is unavailable for this user");
+        }
+        if (task.getDisplayArea() != null && task.getDisplayContent() != display) {
+            throw new IllegalArgumentException("Task belongs to another display");
+        }
+        if (task.getDisplayArea() == null) {
+            android.app.ActivityOptions options = android.app.ActivityOptions.makeBasic();
+            options.setLaunchTaskDisplayArea(launchArea().mRemoteToken.toWindowContainerToken());
+            task = root.anyTaskForId(id, RootWindowContainer.MATCH_ATTACHED_TASK_OR_RECENT_TASKS_AND_RESTORE,
+                    options, true);
+        }
+        return attachedTask(id);
+    }
+
+    private Task topStandard(int panel) {
+        return areas[panel].getTask(task -> task.isLeafTask() && task.isActivityTypeStandard()
+                && service.mAtmService.mAmInternal.isCurrentProfile(task.mUserId)
+                && !task.inPinnedWindowingMode(), true);
+    }
+
+    private void applyMove(ZetaWorkspaceState.Move move) {
+        if (move == null) return;
+        Task task;
+        try {
+            task = attachedTask(move.taskId);
+        } catch (IllegalArgumentException missing) {
+            state.taskRemoved(move.taskId);
+            return;
+        }
+        if (task.getParent() != areas[move.panel]) task.reparent(areas[move.panel], true);
+        task.setWindowingMode(android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN);
+        // The previously focused area can become hidden when spanning/folding.
+        // Reparenting alone does not select the moved root for input/accessibility.
+        if (areas[move.panel].workspaceVisible()) task.moveToFront("zeta-workspace-restore");
+    }
+
+    void moveTask(int id, int panel) {
+        enforceTaskManagementAllowed();
+        if (panel < 0 || panel > ZetaWorkspaceGeometry.RIGHT) {
+            throw new IllegalArgumentException("Move target must be LEFT or RIGHT");
+        }
+        if (state.composition() != ZetaWorkspaceGeometry.SPAN
+                && panel != state.composition()) {
+            throw new IllegalStateException("Cannot move to a hidden panel");
+        }
+        Task task = actionTask(id);
+        service.mAtmService.deferWindowLayout();
+        try {
+            applyMove(state.unspan());
+            if (task.getParent() != areas[panel]) task.reparent(areas[panel], true);
+            task.setWindowingMode(android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN);
+            task.moveToFront("zeta-workspace-move");
+            state.focus(panel, id);
+        } finally {
+            service.mAtmService.continueWindowLayout();
+        }
+        refresh();
+    }
+
+    void spanTask(int id) {
+        enforceTaskManagementAllowed();
+        if (state.composition() != ZetaWorkspaceGeometry.SPAN) {
+            throw new IllegalStateException("Span requires both panels");
+        }
+        Task task = actionTask(id);
+        if (state.spannedTask() == id) return;
+        int owner = ((ZetaTaskDisplayArea) task.getDisplayArea()).panel;
+        if (owner == ZetaWorkspaceGeometry.SPAN) owner = state.focusedPanel();
+        service.mAtmService.deferWindowLayout();
+        try {
+            applyMove(state.unspan());
+            applyMove(state.span(id, owner));
+        } finally {
+            service.mAtmService.continueWindowLayout();
+        }
+        refresh();
+    }
+
+    void userSwitched() {
+        applyMove(state.unspan());
+        state.focus(state.composition() == ZetaWorkspaceGeometry.SPAN ? 0 : state.composition(), -1);
+        refresh();
+    }
+
+    void unspanTask() {
+        enforceTaskManagementAllowed();
+        applyMove(state.unspan());
+        refresh();
+    }
+
+    void swapTasks() {
+        enforceTaskManagementAllowed();
+        if (state.composition() != ZetaWorkspaceGeometry.SPAN || state.spannedTask() >= 0) {
