@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.wm;
+
+import android.content.res.Configuration;
+import android.graphics.Rect;
+import android.view.SurfaceControl;
+
+/** Panel bounds are real window configuration, not a crop of a tablet-sized app. */
+final class ZetaTaskDisplayArea extends TaskDisplayArea {
+    final ZetaWorkspacePolicy workspace;
+    final int panel;
+    ZetaTaskDisplayArea(WindowManagerService service,ZetaWorkspacePolicy workspace,int panel,String name,int feature,boolean home){
+        super(service,name,feature,false,home);this.workspace=workspace;this.panel=panel;
+    }
+    boolean workspaceVisible(){
+        if(workspace.switching)return false;
+        if(!workspace.setupComplete())return panel==ZetaWorkspaceGeometry.LEFT;
+        if(panel==ZetaWorkspaceGeometry.SPAN)return workspace.state.spannedTask()>=0 && workspace.state.composition()==ZetaWorkspaceGeometry.SPAN;
+        if(workspace.state.spannedTask()>=0 && workspace.state.composition()==ZetaWorkspaceGeometry.SPAN)return false;
+        return workspace.state.composition()==ZetaWorkspaceGeometry.SPAN || workspace.state.composition()==panel;
+    }
+    @Override void resolveOverrideConfiguration(Configuration parent){
+        super.resolveOverrideConfiguration(parent);
+        if(workspace==null)return;
+        int rotation=parent.windowConfiguration.getRotation();
+        if(rotation<0||rotation>3)rotation=0;
+        ZetaWorkspaceGeometry.Bounds b=ZetaWorkspaceGeometry.bounds(panel,workspace.state.composition(),rotation);
+        // SetupWizard needs one full-display surface, without changing the
+        // task-area topology that must become dual-pane at first Home.
+        Rect bounds=!workspace.setupComplete() && panel==ZetaWorkspaceGeometry.LEFT
+                ? new Rect(parent.windowConfiguration.getBounds())
+                : new Rect(b.left,b.top,b.right,b.bottom);
+        Configuration resolved=getResolvedOverrideConfiguration();
+        resolved.windowConfiguration.setBounds(bounds);
+        resolved.windowConfiguration.setMaxBounds(bounds);
+        Rect app=new Rect(bounds);
+        Rect parentApp=parent.windowConfiguration.getAppBounds();
+        if(parentApp!=null&&!parentApp.isEmpty())app.intersect(parentApp);
+        resolved.windowConfiguration.setAppBounds(app);
+        int density=parent.densityDpi>0?parent.densityDpi:400;
+        resolved.screenWidthDp=app.width()*160/density;
+        resolved.screenHeightDp=app.height()*160/density;
+        resolved.smallestScreenWidthDp=Math.min(resolved.screenWidthDp,resolved.screenHeightDp);
+        resolved.orientation=app.width()>app.height()?Configuration.ORIENTATION_LANDSCAPE:Configuration.ORIENTATION_PORTRAIT;
+        resolved.screenLayout=Configuration.reduceScreenLayout(Configuration.resetScreenLayout(parent.screenLayout),
+                Math.max(resolved.screenWidthDp,resolved.screenHeightDp),Math.min(resolved.screenWidthDp,resolved.screenHeightDp));
+    }
+    @Override void prepareSurfaces(){
+        SurfaceControl surface=getSurfaceControl();
+        if(surface!=null){
+            Rect bounds=getBounds();
+            getSyncTransaction().setWindowCrop(surface,bounds.width(),bounds.height());
+            if(workspaceVisible())getSyncTransaction().show(surface);else getSyncTransaction().hide(surface);
+        }
+        super.prepareSurfaces();
+    }
+}
diff --git a/services/core/java/com/android/server/wm/ZetaWorkspaceGeometry.java b/services/core/java/com/android/server/wm/ZetaWorkspaceGeometry.java
