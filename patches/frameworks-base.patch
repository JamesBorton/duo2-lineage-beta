+        finishing=true;starting=false;handler.removeCallbacks(deadline);
+        if(view!=null)view.ready=false;
+        request(side<0?2:1,side,code -> {
+            starting=false;
+            if(!ZetaPanelNavigation.state().getBoolean("switching"))remove();
+        });
+        if(!ZetaPanelNavigation.state().getBoolean("switching"))remove();
+    }
+    private void remove() {
+        handler.removeCallbacks(deadline);
+        if(view!=null) {windows.removeViewImmediate(view);view=null;}
+        starting=false;finishing=false;
+    }
+    @Override public void onSensorChanged(SensorEvent event) {
