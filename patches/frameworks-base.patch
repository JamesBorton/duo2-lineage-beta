+        result.putInt("shade_panel", mShadeVisible ? mShadePanel : -1);
+        result.putInt("spanned_task", state.spannedTask());
+        Task left = topStandard(0), right = topStandard(1);
+        result.putIntArray("top_tasks", new int[] {left == null ? -1 : left.mTaskId,
+                right == null ? -1 : right.mTaskId});
+        if (left != null) result.putParcelable("standard_taskinfo_0", left.getTaskInfo());
+        if (right != null) result.putParcelable("standard_taskinfo_1", right.getTaskInfo());
+        if (state.spannedTask() >= 0) {
