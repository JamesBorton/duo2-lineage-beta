+                        && bounds.contains((int) event.getRawX(), (int) event.getRawY())
+                        && event.getRawY() < bounds.top + 24 * density
+                        && event.getRawX() > bounds.left + 32 * density
+                        && event.getRawX() < bounds.right - 32 * density) {
+                    mShadeGesturePanel = panel;
+                    mShadeDownX = event.getRawX(); mShadeDownY = event.getRawY();
+                    break;
+                }
+            }
