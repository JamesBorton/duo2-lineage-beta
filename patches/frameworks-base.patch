+    private void enforceTaskManagementAllowed() {
+        if (switching) throw new IllegalStateException("Screen selection is in progress");
+        if (service.mAtmService.mKeyguardController.isKeyguardLocked(display.mDisplayId)) {
+            throw new IllegalStateException("Task management is unavailable while locked");
+        }
+        if (service.mAtmService.getLockTaskController().isZetaTaskManagementRestricted()) {
+            throw new IllegalStateException("Task management is restricted by screen pinning/device policy");
+        }
+    }
