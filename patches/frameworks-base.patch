@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.util;
+
+/** Same-panel double tap only; a swipe, long press or cancellation cannot select a screen. */
+public final class ZetaScreenTapGesture {
+    private final float slop;
+    private int downPanel=-1, previousPanel=-1;
+    private float x,y,previousX,previousY;
+    private long downTime,previousUp;
+    public ZetaScreenTapGesture(float density){slop=24*density;}
+    public void cancel(){downPanel=previousPanel=-1;}
+    public void down(int panel,float x,float y,long time){this.downPanel=panel;this.x=x;this.y=y;downTime=time;}
+    public void move(float x,float y){if(Math.hypot(x-this.x,y-this.y)>slop)cancel();}
+    public int up(int panel,float x,float y,long time){
+        move(x,y);
+        if(panel<0 || downPanel!=panel || time<downTime || time-downTime>220){cancel();return -1;}
+        downPanel=-1;
+        if(panel==previousPanel && time-previousUp>=40 && time-previousUp<=350
+                && Math.hypot(x-previousX,y-previousY)<=2*slop){cancel();return panel;}
+        previousPanel=panel;previousUp=time;previousX=x;previousY=y;return -1;
+    }
+}
