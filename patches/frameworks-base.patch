@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.shade;
+
+import android.os.Bundle;
+import android.view.MotionEvent;
+import android.view.WindowManagerGlobal;
+import com.android.internal.zeta.ZetaWorkspaceProtocol;
+
+/** One shared shade; capture physical origin before expansion, retain global keyguard scope. */
+public final class ZetaShadeScope {
+    private ZetaShadeScope() { }
+    public static void touch(MotionEvent event) {
+        if (event.getActionMasked() != MotionEvent.ACTION_DOWN) return;
+        try {
+            var wm = WindowManagerGlobal.getWindowManagerService();
+            Bundle state = wm.getZetaWorkspaceState();
+            if (state == null || !state.getBoolean("enabled") || state.getBoolean("locked")
+                    || state.getBoolean("lock_task") || state.getInt("shade_panel", -1) >= 0) return;
+            for (int panel = 0; panel < 2; panel++) {
+                android.graphics.Rect bounds = state.getParcelable("bounds_" + panel, android.graphics.Rect.class);
+                if (bounds != null && bounds.contains((int) event.getRawX(), (int) event.getRawY())) {
+                    wm.zetaWorkspaceAction(ZetaWorkspaceProtocol.SHADE_ORIGIN, panel, -1);
+                    return;
+                }
+            }
+        } catch (android.os.RemoteException | RuntimeException error) {
+            android.util.Log.w("ZetaShadeScope", "Shade origin unavailable", error);
+        }
+    }
+    public static boolean isScoped() {
+        try {
+            Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            return state != null && state.getBoolean("enabled") && !state.getBoolean("locked")
+                    && !state.getBoolean("lock_task") && state.getInt("shade_panel", -1) >= 0;
+        } catch (android.os.RemoteException | RuntimeException error) { return false; }
+    }
+
+    public static void visible(boolean visible) {
+        try {
+            var wm = WindowManagerGlobal.getWindowManagerService();
+            Bundle state = wm.getZetaWorkspaceState();
+            if (state == null || !state.getBoolean("enabled")) return;
+            if (visible && (state.getBoolean("locked") || state.getBoolean("lock_task"))) return;
+            wm.zetaWorkspaceAction(visible ? ZetaWorkspaceProtocol.SHADE_BEGIN
+                    : ZetaWorkspaceProtocol.SHADE_END, -1, -1);
+        } catch (android.os.RemoteException | RuntimeException error) {
+            android.util.Log.w("ZetaShadeScope", "Shade scope unavailable", error);
+        }
+    }
+}
