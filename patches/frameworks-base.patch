+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.util;
+
+import android.graphics.Rect;
+import android.os.Bundle;
+import android.view.View;
+import android.view.WindowManagerGlobal;
+import java.util.WeakHashMap;
+
+/** Hinge-safe interactive content only. Never reduces the global privacy/dim window. */
+public final class ZetaGlobalContentScope {
+    private static final WeakHashMap<View, int[]> sPadding = new WeakHashMap<>();
+    private ZetaGlobalContentScope() { }
+    public static boolean workspaceEnabled() {
+        try {
+            Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            return state != null && state.getBoolean("enabled");
+        } catch (android.os.RemoteException | RuntimeException unavailable) { return false; }
+    }
+    private static int keyguardPanel(Bundle state) {
+        int mode = state.getInt("composition", 2);
+        return state.getInt("keyguard_panel", mode == 2 ? 1 : mode);
+    }
+    public static Rect keyguardPanelBounds() {
+        try {
+            Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            if (state != null && state.getBoolean("enabled")) {
+                Rect bounds = state.getParcelable("bounds_" + keyguardPanel(state), Rect.class);
+                if (bounds != null && !bounds.isEmpty()) return new Rect(bounds);
+            }
+        } catch (android.os.RemoteException | RuntimeException unavailable) { }
+        return null;
+    }
+    /** Position a synthetic lock icon, never a physical fingerprint sensor. */
+    public static android.graphics.Point keyguardIconCenter(android.graphics.Point fallback,
+            float radius, Rect displayBounds) {
+        try {
+            Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            if (state != null && state.getBoolean("enabled") && state.getInt("composition") == 2) {
+                Rect bounds = state.getParcelable("bounds_" + keyguardPanel(state), Rect.class);
+                if (bounds != null && !bounds.isEmpty()) {
+                    int inset = Math.max(Math.round(radius), displayBounds.bottom - fallback.y);
+                    return new android.graphics.Point(bounds.centerX(),
+                            Math.max(bounds.top + Math.round(radius), bounds.bottom - inset));
+                }
+            }
+        } catch (android.os.RemoteException | RuntimeException error) {
+            android.util.Log.w("ZetaGlobalContent", "Lock icon scope unavailable", error);
+        }
+        return fallback;
+    }
+
+    public static boolean fit(View view, int width, int height) {
+        int[] current = {view.getPaddingLeft(), view.getPaddingTop(),
+                view.getPaddingRight(), view.getPaddingBottom()};
+        int[] base = sPadding.get(view);
+        if (base == null) {
+            base = new int[] {current[0], current[1], current[2], current[3],
+                    current[0], current[1], current[2], current[3]};
+            sPadding.put(view, base);
+        } else {
+            // Keep configuration/IME padding changes made by the owning controller.
+            for (int edge = 0; edge < 4; edge++) {
+                if (current[edge] != base[edge + 4]) base[edge] = current[edge];
