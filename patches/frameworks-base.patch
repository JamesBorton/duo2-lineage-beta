+        }
+    }
+
+    private void collapseOwnShade(int panel) {
+        if (state().getInt("shade_panel", -1) == panel) {
+            android.app.StatusBarManager status = mContext.getSystemService(android.app.StatusBarManager.class);
+            if (status != null) status.collapsePanels();
+        }
+    }
+
+    private void action(int action, int panel) {
+        if (action == ZetaWorkspaceProtocol.HOME || action == ZetaWorkspaceProtocol.OVERVIEW) {
+            collapseOwnShade(panel);
+        }
+        try {
+            WindowManagerGlobal.getWindowManagerService().zetaWorkspaceAction(action, panel, -1);
+        } catch (RemoteException | IllegalStateException | IllegalArgumentException error) {
+            Log.w("ZetaPanelNavigation", "Panel action unavailable", error);
+        }
+    }
+
+    private void back(int panel) {
+        if (state().getInt("shade_panel", -1) == panel) {
+            collapseOwnShade(panel);
+            return;
+        }
+        action(ZetaWorkspaceProtocol.FOCUS, panel);
