+        if (mShadeMonitor != null) { mShadeMonitor.dispose(); mShadeMonitor = null; }
+    }
+
+    private void updateShadeMonitor(boolean workspace, Bundle snapshot) {
+        boolean lowerPane = false;
+        if (workspace && snapshot.getInt("composition", 2) == 2) {
+            for (int panel = 0; panel < 2; panel++) {
+                Rect bounds = snapshot.getParcelable("bounds_" + panel, Rect.class);
+                lowerPane |= bounds != null && bounds.top > 0;
+            }
+        }
