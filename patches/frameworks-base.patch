+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.navigationbar;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.os.Bundle;
+import android.view.View;
+
+/** Non-interactive highlight for the touchable hinge drop bands. Does not provide app insets. */
+final class ZetaTaskDropHint extends View {
+    private final Rect mLeft = new Rect(), mRight = new Rect();
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private int mOrigin;
+    ZetaTaskDropHint(Context context) { super(context); setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO); }
+    void update(Bundle state) {
+        Rect left = state.getParcelable("bounds_0", Rect.class);
+        Rect right = state.getParcelable("bounds_1", Rect.class);
+        if (left != null) mLeft.set(left);
+        if (right != null) mRight.set(right);
+        mOrigin = state.getInt("focused_panel", 0);
+        invalidate();
+    }
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (mLeft.isEmpty() || mRight.isEmpty()) return;
+        float density = getResources().getDisplayMetrics().density;
+        int band = Math.round(32 * density);
+        mPaint.setColor(Color.argb(125, 80, 170, 255));
+        if (mLeft.right <= mRight.left) {
+            canvas.drawRect(mLeft.right-band,mLeft.top,mLeft.right,mLeft.bottom,mPaint);
+            canvas.drawRect(mRight.left,mRight.top,mRight.left+band,mRight.bottom,mPaint);
+        } else if (mRight.right <= mLeft.left) {
+            canvas.drawRect(mRight.right-band,mRight.top,mRight.right,mRight.bottom,mPaint);
+            canvas.drawRect(mLeft.left,mLeft.top,mLeft.left+band,mLeft.bottom,mPaint);
+        } else if (mLeft.bottom <= mRight.top) {
+            canvas.drawRect(mLeft.left,mLeft.bottom-band,mLeft.right,mLeft.bottom,mPaint);
+            canvas.drawRect(mRight.left,mRight.top,mRight.right,mRight.top+band,mPaint);
+        } else {
+            canvas.drawRect(mRight.left,mRight.bottom-band,mRight.right,mRight.bottom,mPaint);
+            canvas.drawRect(mLeft.left,mLeft.top,mLeft.right,mLeft.top+band,mPaint);
+        }
+        Rect origin = mOrigin == 0 ? mLeft : mRight;
+        float width = Math.min(origin.width()-32*density, 460*density);
+        float top = origin.top+48*density;
+        mPaint.setColor(Color.argb(220,20,20,20));
+        canvas.drawRoundRect(new RectF(origin.exactCenterX()-width/2,top,
+                origin.exactCenterX()+width/2,top+48*density),12*density,12*density,mPaint);
+        mPaint.setColor(Color.WHITE);
+        mPaint.setTextAlign(Paint.Align.CENTER);
+        mPaint.setTextSize(16*density);
+        canvas.drawText("Drop near the hinge to use both screens",origin.exactCenterX(),top+30*density,mPaint);
+    }
+}
