+        try {
+            Bundle state = WindowManagerGlobal.getWindowManagerService().getZetaWorkspaceState();
+            if (state != null && state.getBoolean("enabled") && state.getInt("composition") == 2) {
+                int panel = state.getBoolean("locked") ? keyguardPanel(state) : state.getInt("focused_panel", 0);
+                Rect bounds = state.getParcelable("bounds_" + panel, Rect.class);
+                int[] position = new int[2];
+                view.getLocationOnScreen(position);
+                // Bouncer/auth animations translate ancestors without changing layout bounds.
+                // Do not convert an animation offset into permanent content padding.
+                View ancestor = view;
+                while (ancestor != null) {
+                    position[0] -= Math.round(ancestor.getTranslationX());
+                    position[1] -= Math.round(ancestor.getTranslationY());
+                    ancestor = ancestor.getParent() instanceof View ? (View) ancestor.getParent() : null;
+                }
+                Rect content = new Rect(position[0], position[1], position[0] + width, position[1] + height);
+                if (bounds != null && content.intersect(bounds)) {
+                    left = Math.max(left, content.left - position[0]);
+                    top = Math.max(top, content.top - position[1]);
+                    right = Math.max(right, position[0] + width - content.right);
+                    bottom = Math.max(bottom, position[1] + height - content.bottom);
