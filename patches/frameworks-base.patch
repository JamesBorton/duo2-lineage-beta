+                new InsetsFrameProvider(owner, 0, WindowInsets.Type.navigationBars())
+                        .setSource(InsetsFrameProvider.SOURCE_FRAME)
+                        .setInsetsSize(Insets.of(0, 0, 0, height)),
+                new InsetsFrameProvider(owner, 0, WindowInsets.Type.tappableElement())
+                        .setSource(InsetsFrameProvider.SOURCE_FRAME)
+                        .setInsetsSize(Insets.of(0, 0, 0, mNavigationMode == 2 ? 0 : height))};
+        mBars[panel] = bar;
+        mParams[panel] = attrs;
+        mWindows.addView(bar, attrs);
+    }
+
+    void update() {
+        Bundle state = state();
+        int mode = mContext.getResources().getInteger(com.android.internal.R.integer.config_navBarInteractionMode);
+        if (mNavigationMode != mode) {
+            for (int panel = 0; panel < 2; panel++) {
+                if (mBars[panel] != null) mWindows.removeViewImmediate(mBars[panel]);
+                mBars[panel] = null;
+                mParams[panel] = null;
+            }
+            mNavigationMode = mode;
+        }
+        boolean workspace = state.getBoolean("enabled", false) && !state.getBoolean("switching", false)
+                && !state.getBoolean("locked", false)
+                && !state.getBoolean("lock_task", false)
+                && !mKeyguard.isShowing();
+        updateShadeMonitor(workspace, state);
+        mClassic.setVisibility(workspace ? View.GONE : View.VISIBLE);
+        if (!workspace && mClassic.getWidth() > 0 && mClassic.getHeight() > 0) {
+            com.android.systemui.util.ZetaGlobalContentScope.fit(mClassic,
+                    mClassic.getWidth(), mClassic.getHeight());
+        }
+        int composition = state.getInt("composition", 2);
+        boolean dragging = workspace && composition == 2 && state.getBoolean("dragging", false);
+        if (dragging) {
+            if (mDropHint == null) {
+                mDropHint = new ZetaTaskDropHint(mContext);
+                WindowManager.LayoutParams hintParams = new WindowManager.LayoutParams(-1, -1,
+                        WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                        WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                                | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                                | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                        android.graphics.PixelFormat.TRANSLUCENT);
+                hintParams.setTitle("Zeta task drop hint");
+                hintParams.setFitInsetsTypes(0);
+                hintParams.setTrustedOverlay();
+                mWindows.addView(mDropHint, hintParams);
+            }
+            mDropHint.update(state);
+        } else if (mDropHint != null) {
+            mWindows.removeViewImmediate(mDropHint);
+            mDropHint = null;
+        }
+        int height = mContext.getResources().getDimensionPixelSize(
+                com.android.internal.R.dimen.navigation_bar_height);
+        for (int panel = 0; panel < 2; panel++) {
+            boolean show = workspace && (composition == 2 || composition == panel);
+            Rect bounds = state.getParcelable("bounds_" + panel, Rect.class);
+            if (!show || bounds == null || bounds.isEmpty()) {
+                if (mBars[panel] != null) mBars[panel].setVisibility(View.GONE);
+                continue;
+            }
+            if (mBars[panel] == null) create(panel, bounds, height);
+            WindowManager.LayoutParams attrs = mParams[panel];
+            if (attrs.x != bounds.left || attrs.y != bounds.bottom - height
+                    || attrs.width != bounds.width() || attrs.height != height) {
+                attrs.x = bounds.left;
+                attrs.y = bounds.bottom - height;
+                attrs.width = bounds.width();
+                attrs.height = height;
+                mWindows.updateViewLayout(mBars[panel], attrs);
+            }
+            mBars[panel].setVisibility(View.VISIBLE);
+        }
+    }
+
+    void close() {
+        disposeShadeMonitor();
+        mScreenSelection.dispose();
+        if (mDropHint != null) { mWindows.removeViewImmediate(mDropHint); mDropHint = null; }
+        mContext.unregisterReceiver(mReceiver);
+        mKeyguard.removeCallback(mLockCallback);
+        mClassic.removeOnLayoutChangeListener(mClassicLayout);
+        for (LinearLayout bar : mBars) if (bar != null) mWindows.removeViewImmediate(bar);
+        mClassic.setVisibility(View.VISIBLE);
+    }
+}
