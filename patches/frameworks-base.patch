+        result.setImageTintList(android.content.res.ColorStateList.valueOf(Color.WHITE));
+        result.setBackgroundColor(Color.TRANSPARENT);
+        result.setContentDescription(label);
+        result.setOnClickListener(view -> click.run());
+        return result;
+    }
+
+    private void create(int panel, Rect bounds, int height) {
+        LinearLayout bar = new LinearLayout(mContext);
+        bar.setOrientation(LinearLayout.HORIZONTAL);
+        bar.setGravity(Gravity.CENTER);
+        bar.setBackgroundColor(Color.BLACK);
+        String side = panel == 0 ? "left screen" : "right screen";
+        if (mNavigationMode == 2) {
+            bar.setGravity(Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+            bar.setContentDescription("Navigation gestures, " + side);
+            View handle = new View(mContext);
+            android.graphics.drawable.GradientDrawable shape = new android.graphics.drawable.GradientDrawable();
+            shape.setColor(Color.WHITE);
+            shape.setCornerRadius(20);
+            handle.setBackground(shape);
+            handle.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            float density = mContext.getResources().getDisplayMetrics().density;
+            LinearLayout.LayoutParams handleParams = new LinearLayout.LayoutParams(
+                    Math.round(108 * density), Math.max(1, Math.round(4 * density)));
+            handleParams.bottomMargin = Math.round(6 * density);
+            bar.addView(handle, handleParams);
+        } else for (ImageButton button : new ImageButton[] {
+                button(R.drawable.ic_sysbar_back, "Back, " + side, () -> back(panel)),
+                button(R.drawable.ic_sysbar_home, "Home, " + side,
