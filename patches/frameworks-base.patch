+    private final Runnable poll = new Runnable() {
+        public void run() { update(); if (!disposed) handler.postDelayed(this, 350); }
+    };
+    ZetaScreenSelection(Context context) {
+        // Navigation's supplied context can carry a single-panel token configuration.
+        // A dedicated system-window context follows the physical display instead.
+        this.context=context.createDisplayContext(context.getDisplay()).createWindowContext(
