+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.util;
+
+/** Content-only placement: the enclosing keyguard and privacy scrim remain full-window. */
+public class ZetaKeyguardIndicationLayout extends android.widget.LinearLayout {
+    public ZetaKeyguardIndicationLayout(android.content.Context context, android.util.AttributeSet attrs) {
+        super(context, attrs);
+    }
+    @Override protected void onMeasure(int widthSpec, int heightSpec) {
+        android.graphics.Rect bounds = ZetaGlobalContentScope.keyguardPanelBounds();
+        int width = MeasureSpec.getSize(widthSpec);
+        int[] location = new int[2]; getLocationOnScreen(location);
+        if (bounds != null && width > 0) {
+            int left = Math.max(0, bounds.left - location[0]);
+            int right = Math.max(0, location[0] + width - bounds.right);
+            if (left + right < width) setPadding(left, 0, right, 0);
+        } else setPadding(0, 0, 0, 0);
+        super.onMeasure(widthSpec, heightSpec);
+    }
+    @Override protected void onLayout(boolean changed, int l, int t, int r, int b) {
+        super.onLayout(changed, l, t, r, b);
+        android.graphics.Rect bounds = ZetaGlobalContentScope.keyguardPanelBounds();
+        android.view.WindowManager wm = getContext().getSystemService(android.view.WindowManager.class);
+        int bottom = wm.getCurrentWindowMetrics().getBounds().height();
+        setTranslationY(bounds == null ? 0 : Math.min(0, bounds.bottom - bottom));
+    }
+}
