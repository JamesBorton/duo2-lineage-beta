android_app {
    name: "ZetaPostureController",
    srcs: ["src/**/*.java"],
    static_libs: ["zeta-posture-contract", "vendor.surface.displaytopology-V1.0-java", "vendor.surface.touchpen-V1.0-java"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: { enabled: false },
}
