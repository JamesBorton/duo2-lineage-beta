android_test {
    name: "ZetaWorkspacePermissionTests",
    srcs: ["src/**/*.java", ":zeta-surface-transport-srcs"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    min_sdk_version: "36",
    static_libs: ["androidx.test.runner", "androidx.test.ext.junit", "junit", "SystemUISharedLib"],
    test_suites: ["general-tests"],
    optimize: { enabled: false },
}
